# TAKATAK User Official Dashboard V1 — environment template
# Copy to .env.local and fill with real values. NEVER commit real secrets.
# All values below are empty placeholders.

# ── App ─────────────────────────────────────────────
# Local `.env` / `next dev`: keep localhost.
# Production upload remaps localhost → https://takatak.ca automatically.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME="TAKATAK User Official Dashboard V1"

# ── Database (Prisma / Supabase Postgres) ───────────
DATABASE_URL=
DIRECT_URL=
# MochaHost: do not click "Run NPM Install". It forks Prisma and 503s the site.
# If you must install, keep this set and upload .npmrc (ignore-scripts=true).
# PRISMA_SKIP_POSTINSTALL_GENERATE=1

# ── Supabase (Auth / Postgres / Storage) ────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── OTP login / register ────────────────────────────────────────────
# Gmail SMTP (use this now). Create an App Password in Google Account.
EMAIL_USER=
EMAIL_PASSWORD=
# Optional. Defaults to EMAIL_USER.
SENDER_EMAIL=
# Optional SMTP overrides. Defaults are Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SendGrid later. If SENDGRID_API_KEY is set, email goes through SendGrid instead.
SENDGRID_API_KEY=
# Phone codes: Twilio Verify. Optional. Leave empty to use email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Native social platform security ─────────────────
# Generate a 32-byte Base64 key:
# openssl rand -base64 32
#
# Never expose this value through NEXT_PUBLIC_* variables.
SOCIAL_TOKEN_ENCRYPTION_KEY_V1=
SOCIAL_TOKEN_ACTIVE_KEY_VERSION=1

# ── Direct social provider applications ─────────────
# Meta will be the first implemented live provider.
META_APP_ID=
META_APP_SECRET=
# Competitor tracking requires Meta Page Public Metadata Access (App Review).
# forced_unavailable = always show honest unavailable UI (no scraping).
# true = allow live pages/search capability probe with app access token.
META_COMPETITOR_PUBLIC_ACCESS=
# Exact callback URI registered in the Meta app (no trailing slash).
# Local `.env`: http://localhost:3000/api/social/callback/facebook
# Production upload remaps that localhost callback to
# https://takatak.ca/api/social/callback/facebook
# Register BOTH URIs in the Meta app.
# Optional production relay (see deploy/oauth-callback-relay/) can replace
# the public callback so Meta's ?code=&state= never hit Vercel access logs.
META_OAUTH_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0

# Google (YouTube live; Google Business Profile waits on API access approval)
GOOGLE_SOCIAL_CLIENT_ID=
GOOGLE_SOCIAL_CLIENT_SECRET=
# Exact callback URI registered on the Google OAuth Web client (no trailing slash).
# Local: http://localhost:3000/api/social/callback/google
# Production: https://takatak.ca/api/social/callback/google
# Register BOTH URIs on the same client. Optional; defaults to {origin}/api/social/callback/google.
GOOGLE_OAUTH_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Exact callback URI registered in the TikTok Login Kit product (no trailing slash).
# Local `.env`: http://localhost:3000/api/social/callback/tiktok
# Production upload remaps that localhost callback to
# https://takatak.ca/api/social/callback/tiktok
# Register BOTH URIs in the TikTok app. TikTok web Login Kit prefers https.
TIKTOK_OAUTH_REDIRECT_URI=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact callback URI registered in the X OAuth 2.0 app (no trailing slash).
# Local `.env`: http://localhost:3000/api/social/callback/x
# Production upload remaps that localhost callback to
# https://takatak.ca/api/social/callback/x
# Register BOTH URIs in the X developer portal. PKCE is required.
X_OAUTH_REDIRECT_URI=

BLUESKY_APP_PASSWORD=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Stripe (Social billing — Step 6) ────────────────
# Test mode only on local machines. Never put live keys in .env.
# Checkout stays disabled until secret + webhook secret + at least one Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Receiver: POST {NEXT_PUBLIC_APP_URL}/api/billing/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid,
# invoice.payment_failed.
# Create CAD Prices in the Stripe Dashboard, then paste the price_ IDs.
STRIPE_PRICE_SOCIAL_STARTER_5_MONTHLY=
STRIPE_PRICE_SOCIAL_STARTER_5_ANNUAL=
STRIPE_PRICE_SOCIAL_STARTER_10_MONTHLY=
STRIPE_PRICE_SOCIAL_STARTER_10_ANNUAL=
STRIPE_PRICE_SOCIAL_ADVANCED_15_MONTHLY=
STRIPE_PRICE_SOCIAL_ADVANCED_15_ANNUAL=
STRIPE_PRICE_SOCIAL_ADVANCED_25_MONTHLY=
STRIPE_PRICE_SOCIAL_ADVANCED_25_ANNUAL=
STRIPE_PRICE_SOCIAL_ADVANCED_50_MONTHLY=
STRIPE_PRICE_SOCIAL_ADVANCED_50_ANNUAL=
# Add-ons (Step 7). Same billing cycle as the Social plan. Starter+ only.
STRIPE_PRICE_SOCIAL_ADDON_X_ACCOUNT_MONTHLY=
STRIPE_PRICE_SOCIAL_ADDON_X_ACCOUNT_ANNUAL=
STRIPE_PRICE_SOCIAL_ADDON_ADVANCED_ANALYTICS_MONTHLY=
STRIPE_PRICE_SOCIAL_ADDON_ADVANCED_ANALYTICS_ANNUAL=

# ── Metricool (social media engine) ─────────────────
METRICOOL_API_KEY=
METRICOOL_ACCOUNT_ID=
METRICOOL_WHITE_LABEL_BASE_URL=
# Leave the two below EMPTY until confirmed from official Metricool docs or
# your account settings. They are never guessed; without them the provider
# state stays "configured_untested" and no live request is attempted.
METRICOOL_API_BASE_URL=
METRICOOL_TEST_ENDPOINT=

# ── TryHolo (optional creative AI provider) ─────────
TRYHOLO_API_KEY=
TRYHOLO_ENABLED=false

# ── Upmind (web / domain / hosting engine) ──────────
# Former backend used UPMIND_KEY. Either name is accepted.
UPMIND_API_KEY=
UPMIND_KEY=
UPMIND_API_BASE_URL=
NEXT_PUBLIC_UPMIND_BRAND_ID=
NEXT_PUBLIC_UPMIND_ORDER_CONFIG_URL=
NEXT_PUBLIC_UPMIND_CURRENCY=CAD
# Paste the secret Upmind shows when you create the webhook endpoint
# (Settings → Webhooks). Never commit the real value.
UPMIND_WEBHOOK_SECRET=
# Leave UPMIND_TEST_ENDPOINT EMPTY until confirmed from official Upmind docs
# or your account settings. It is never guessed; without it the provider
# state stays "configured_untested" and no live request is attempted.
UPMIND_TEST_ENDPOINT=
# Receiver path: POST {NEXT_PUBLIC_APP_URL}/api/integrations/upmind/webhook
# Upmind cannot call localhost. Use production HTTPS or a public tunnel.
# Stay false until the secret and public URL are in place.
UPMIND_WEBHOOK_ENABLED=false

# ── QMAPS (local listings) ──────────────────────────
QMAPS_API_KEY=
QMAPS_API_BASE_URL=

# ── FLEXS (lead generation) ─────────────────────────
FLEXS_API_KEY=
FLEXS_API_BASE_URL=

# ── AI providers ────────────────────────────────────
OPENAI_API_KEY=

# ── Phase 14: production safety flags (safe defaults — keep false) ─────────
# Allows no-auth foundation mode in a PRODUCTION runtime. Unsafe for public
# production; exists only for controlled demos/QA. Default MUST stay false.
TAKATAK_FOUNDATION_MODE_ENABLED=false
# Allows the foundation/demo seed to run when NODE_ENV=production.
# Never enable against a real customer database.
ALLOW_FOUNDATION_SEED=false
# Exposes detailed capability info on /api/health. Public production default
# is the minimal {status, app} response.
HEALTH_DETAILS_ENABLED=false

# ── Phase 15A: owner bootstrap (deliberate operation only) ─────────────────
# Used ONLY by `npm run bootstrap:owner` to promote the first owner profile.
# Never set in deployed runtime env. See scripts/bootstrap-owner.ts.
BOOTSTRAP_OWNER_EMAIL=
