# Environment names only. Never put real secrets in this file.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://takatak.ca

# Temporary server-only OAuth setup allowlist.
# Remove the UUID after all social accounts are connected.
# SOCIAL_CONNECTION_SETUP_CLIENT_IDS=614c6e69-3006-422b-9aa8-00fba5f4ff94

DATABASE_URL=
DIRECT_URL=
PGSSL_REJECT_UNAUTHORIZED=false
PRISMA_POOL_MAX=3

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

EMAIL_USER=
EMAIL_PASSWORD=
SENDER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional phone OTP
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Optional Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional Upmind
# UPMIND_API_KEY=
# UPMIND_API_BASE_URL=
# UPMIND_BRAND_ID=

# Rentauto -> TAKATAK server-to-server synchronization
RENTAUTO_SYNC_ENABLED=false
RENTAUTO_SYNC_CLIENT_ID=
RENTAUTO_SYNC_WEBHOOK_SECRET=

# 1LV -> TAKATAK master identity / commerce projection.
# Dedicated to 1LV. Never reuse this key for RENTAUTO, R2NETTE or another app.
# Use the same secret as 1LV's server-side TAKATAK_1LV_API_KEY.
TAKATAK_1LV_API_KEY=

# AHMV billing — server-side, disabled by default.
# Product prices/intervals live in the product catalog database.
HOCKEY_MEMBERSHIP_SELF_SERVE_ENABLED=false
STRIPE_HOCKEY_WEBHOOK_SECRET=
# Legacy migration compatibility only. Do not use this variable as the source
# of plan price/interval; those are resolved from product_prices.
STRIPE_PRICE_HOCKEY_MEMBER_WEEKLY_10=

# AHMV Community Content / moderation bridge — server-to-server only.
# Dedicated credential. Do not reuse the schedule read or ingest token.
TAKATAK_AHMV_CONTENT_TOKEN=
# Default moderation mailbox requested for the AHMV publisher; may be overridden.
AHMV_CONTRIBUTION_MODERATOR_EMAIL=OHMVVerdun.ca@gmail.com

# AHMV independent product experience + Phone/SMS/Voice bridge — server-to-server only.
# Use the same high-entropy service token on TAKATAK and AHMV; never expose it with NEXT_PUBLIC_.
TAKATAK_AHMV_SERVICE_TOKEN=
AHMV_EXPERIENCE_CALLBACK_URL=https://ahmverdun.ca/api/ahmv/experience/callback
# Separate write credential for the trusted official schedule importer.
TAKATAK_AHMV_INGEST_TOKEN=
# Reject read access when the latest source snapshot is older than this.
AHMV_SCHEDULE_MAX_AGE_MINUTES=360

# AHMV Parent/Family backend — server-only and disabled by default.
# Supporter thank-you credits use signed server-to-server events.
AHMV_SUPPORTER_SYNC_ENABLED=false
AHMV_SUPPORTER_SYNC_CLIENT_ID=
AHMV_SUPPORTER_SYNC_WEBHOOK_SECRET=

# Official/public team-event projection into the parent event engine.
AHMV_EVENT_SYNC_ENABLED=false
AHMV_EVENT_SYNC_CLIENT_ID=
AHMV_EVENT_SYNC_WEBHOOK_SECRET=
AHMV_EVENT_REQUIRE_SOURCE_URL=false
AHMV_EVENT_ALLOWED_SOURCE_HOSTS=

# Parent SMS delivery. Reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN when enabled.
HOCKEY_SMS_ENABLED=false
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
HOCKEY_DELIVERY_WORKER_ENABLED=false
HOCKEY_DELIVERY_WORKER_SECRET=

# Identity-scoped Google Calendar OAuth.
HOCKEY_GOOGLE_CALENDAR_ENABLED=false
GOOGLE_HOCKEY_CLIENT_ID=
GOOGLE_HOCKEY_CLIENT_SECRET=
GOOGLE_HOCKEY_REDIRECT_URI=https://takatak.ca/api/hockey/calendar/google/callback
HOCKEY_TOKEN_ENCRYPTION_KEY_V1=
HOCKEY_TOKEN_ACTIVE_KEY_VERSION=1

# Smart Departure / Google Routes. Disabled until provider billing + key are configured.
HOCKEY_SMART_DEPARTURE_ENABLED=false
GOOGLE_MAPS_ROUTES_API_KEY=
HOCKEY_TRAVEL_ACTIVE_KEY_VERSION=1
HOCKEY_TRAVEL_ENCRYPTION_KEY_V1=

# AHMV exact-team public social feed bridge. Server-to-server only.
AHMV_TEAM_FEED_ENABLED=false
AHMV_TEAM_FEED_SHARED_TOKEN=

# TAKATAK ADS — server-only secrets. Never prefix with NEXT_PUBLIC_.
# Strong random values, minimum 32 characters. Keep blank until ADS is deployed.
ADS_EVENT_SIGNING_SECRET=
# Shared only between the FLEXS server and TAKATAK ADS attribution endpoint.
ADS_FLEXS_SERVICE_TOKEN=

# Growth Suite connectors — server-only, presence-checked. A connector shows
# "Credentials set — untested" when all of its vars exist; never "connected"
# until a real adapter call succeeds. Leave blank until each provider is approved.
# AI Gateway (owner's own AI backend; routes to the 13 engines and debits credits)
TAKATAK_AI_GATEWAY_URL=
# Shared secret, >= 32 random chars. Enables /api/ai/credits/* for the gateway.
TAKATAK_AI_GATEWAY_TOKEN=
# AI engines (read for presence only; keys normally live on the gateway)
# ANTHROPIC_API_KEY= GEMINI_API_KEY= MISTRAL_API_KEY= XAI_API_KEY= PERPLEXITY_API_KEY=
# DEEPSEEK_API_KEY= GROQ_API_KEY= COHERE_API_KEY= ELEVENLABS_API_KEY= RUNWAYML_API_SECRET=
# STABILITY_API_KEY= HEYGEN_API_KEY=
# TAKATAK Analytics: >= 32 random chars keeps daily visitor ids stable across processes.
ANALYTICS_HASH_SECRET=
# Client IP for public rate limits and visitor ids. The client is the
# X-Forwarded-For entry TRUSTED_PROXY_HOPS from the right (1 = one proxy such as
# Vercel or Coolify/Traefik; 2 = Cloudflare in front of Traefik). Or name a
# trusted header your platform sets, e.g. CLIENT_IP_HEADER=cf-connecting-ip.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# Google (Analytics 4, Search Console) service account. Each client grants this account
# read access to its own GA4 property / Search Console site; IDs are linked per website.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_TAG_MANAGER_ID=
MICROSOFT_CLARITY_PROJECT_ID=
# Ads networks
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_REFRESH_TOKEN=
# Reviews & local
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_ENABLED=false
# Optional; defaults to <app origin>/api/integrations/google-business/callback
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=
# 32 random bytes (Base64 or 64 hex). Encrypts per-client OAuth refresh tokens.
GROWTH_TOKEN_ENCRYPTION_KEY_V1=
YELP_API_KEY=
TRUSTPILOT_API_KEY=
TRUSTPILOT_API_SECRET=
BRIGHTLOCAL_API_KEY=
BRIGHTLOCAL_API_SECRET=
# Messaging
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# SEO data
PAGESPEED_API_KEY=
SEMRUSH_API_KEY=
AHREFS_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Domains / DNS
CLOUDFLARE_API_TOKEN=
# Growth Suite automatic delivery (off unless each flag is true AND creds are set)
GROWTH_SMS_ENABLED=false
GROWTH_WHATSAPP_ENABLED=false
WHATSAPP_REVIEW_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=fr_CA
# Explicit Graph API version, e.g. v21.0 — never guessed by the app.
WHATSAPP_GRAPH_VERSION=
# AI credit card checkout (Stripe). Keep false until pack prices are confirmed.
AI_CREDITS_CHECKOUT_ENABLED=false
STRIPE_AI_CREDITS_WEBHOOK_SECRET=
# Growth plan subscriptions (Stripe). Keep false until plan prices are confirmed.
GROWTH_BILLING_ENABLED=false
STRIPE_GROWTH_WEBHOOK_SECRET=
# Require a plan for each Growth feature (off during the pilot).
GROWTH_ENTITLEMENTS_ENFORCED=false
