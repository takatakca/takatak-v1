# Environment names only. Never put real secrets in this file.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://takatak.ca

# Temporary server-only OAuth setup allowlist.
# Remove the UUID after all social accounts are connected.
# SOCIAL_CONNECTION_SETUP_CLIENT_IDS=614c6e69-3006-422b-9aa8-00fba5f4ff94

DATABASE_URL=
DIRECT_URL=
PGSSL_REJECT_UNAUTHORIZED=false
PRISMA_POOL_MAX=3

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

EMAIL_USER=
EMAIL_PASSWORD=
SENDER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional phone OTP
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Optional Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional Upmind
# UPMIND_API_KEY=
# UPMIND_API_BASE_URL=
# UPMIND_BRAND_ID=

# Rentauto -> TAKATAK server-to-server synchronization
RENTAUTO_SYNC_ENABLED=false
RENTAUTO_SYNC_CLIENT_ID=
RENTAUTO_SYNC_WEBHOOK_SECRET=

# 1LV -> TAKATAK master identity / commerce projection.
# Dedicated to 1LV. Never reuse this key for RENTAUTO, R2NETTE or another app.
# Use the same secret as 1LV's server-side TAKATAK_1LV_API_KEY.
TAKATAK_1LV_API_KEY=

# AHMV hockey membership billing — server-side, disabled by default.
# Uses the shared STRIPE_SECRET_KEY but a dedicated webhook endpoint/secret.
HOCKEY_MEMBERSHIP_SELF_SERVE_ENABLED=false
STRIPE_HOCKEY_WEBHOOK_SECRET=
STRIPE_PRICE_HOCKEY_MEMBER_WEEKLY_10=

# AHMV supporter thank-you credits — signed server-to-server events.
# Keep disabled until the supporter payment source is ready to emit signed events.
AHMV_SUPPORTER_SYNC_ENABLED=false
AHMV_SUPPORTER_SYNC_CLIENT_ID=
AHMV_SUPPORTER_SYNC_WEBHOOK_SECRET=

# AHMV official/public team-event projection -> TAKATAK Parent Premium engine.
# Dedicated HMAC integration. Do not reuse supporter or other app secrets.
AHMV_EVENT_SYNC_ENABLED=false
AHMV_EVENT_SYNC_CLIENT_ID=
AHMV_EVENT_SYNC_WEBHOOK_SECRET=

# AHMV Parent Premium SMS delivery.
# Reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN, but not Twilio Verify.
HOCKEY_SMS_ENABLED=false
TWILIO_MESSAGING_SERVICE_SID=
# Alternative to Messaging Service SID:
TWILIO_SMS_FROM=

# Internal batch worker authorization. Use a long random server-only value.
HOCKEY_DELIVERY_WORKER_ENABLED=false
HOCKEY_DELIVERY_WORKER_SECRET=

# AHMV Parent Premium Google Calendar — identity scoped, server-only OAuth.
# Register the exact redirect URI in the Google Cloud OAuth client.
HOCKEY_GOOGLE_CALENDAR_ENABLED=false
GOOGLE_HOCKEY_CLIENT_ID=
GOOGLE_HOCKEY_CLIENT_SECRET=
GOOGLE_HOCKEY_REDIRECT_URI=https://takatak.ca/api/hockey/calendar/google/callback

# Dedicated AES-256-GCM key for hockey/calendar OAuth credentials.
# 32-byte Base64 or 64-character hex. Never expose with NEXT_PUBLIC_.
HOCKEY_TOKEN_ENCRYPTION_KEY_V1=
HOCKEY_TOKEN_ACTIVE_KEY_VERSION=1

# AHMV public event source filtering.
# Production must require provenance and use an explicit exact-host allowlist.
# Current website references that may be approved during cutover include:
# ahmverdun.com (legacy public schedule surface)
# scoresheets.ca (public simple-letter schedules)
# page.spordle.com (public Spordle schedules/tournaments)
# www.wllv.org (public WLLV schedule gateway)
# Do not add ahmverdun.ca merely because it is the new presentation domain.
AHMV_EVENT_REQUIRE_SOURCE_URL=false
AHMV_EVENT_ALLOWED_SOURCE_HOSTS=

# AHMV Parent Premium smart departure — disabled until Routes API billing/key
# restrictions and encrypted parent-origin storage are verified in production.
HOCKEY_SMART_DEPARTURE_ENABLED=false
GOOGLE_MAPS_ROUTES_API_KEY=

# Dedicated encryption key for parent-approved departure coordinates.
HOCKEY_TRAVEL_ACTIVE_KEY_VERSION=1
HOCKEY_TRAVEL_ENCRYPTION_KEY_V1=

# AHMV exact-team public social feed bridge. Server-to-server only.
AHMV_TEAM_FEED_ENABLED=false
AHMV_TEAM_FEED_SHARED_TOKEN=
