# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage



# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloned public-site source used for landing design port
.tmp-takatak-automate

# Prisma client generated for MochaHost upload (includes Linux engines)
/prisma/generated
/prisma/.generated-schema.sha256

# Production artifacts (never commit secrets or full node_modules tarballs)
/var/artifacts

# Local / CI ephemeral Supabase volumes and generated seed
/supabase/.temp
/supabase/.branches

/newfixarchv/
