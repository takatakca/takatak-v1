{
  "name": "takatak-user-official-dashboard-v1",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node prisma/generate.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:auth": "tsx --require ./scripts/register-server-only.cjs scripts/auth-otp-tests.ts && tsx --require ./scripts/register-server-only.cjs scripts/auth-session-tests.ts && tsx --require ./scripts/register-server-only.cjs scripts/auth-frontend-tests.ts && tsx --require ./scripts/register-server-only.cjs scripts/auth-cookie-tests.ts && tsx --require ./scripts/register-server-only.cjs scripts/deployment-guard-tests.ts",
    "test:identity": "tsx --require ./scripts/register-server-only.cjs scripts/identity-isolation-tests.ts",
    "check:modules": "tsx scripts/check-compiled-modules.ts && tsx scripts/check-module-load.ts",
    "check:sources": "node scripts/check-required-sources.cjs",
    "preflight": "tsx scripts/production-preflight.ts",
    "artifact:pack": "node scripts/pack-production-artifact.cjs",
    "artifact:audit": "node scripts/audit-production-artifact.cjs",
    "artifact:smoke": "node scripts/artifact-startup-smoke.cjs",
    "smoke:auth": "tsx scripts/smoke-auth-json.ts",
    "qa": "npm run db:generate && npm run check:sources && npm run typecheck && npm run lint && npm run test:auth && npm run test:identity && npm run build && npm run check:modules",
    "qa:auth": "npm run test:auth",
    "qa:secrets": "tsx scripts/check-secrets.ts",
    "qa:readiness": "tsx scripts/check-readiness.ts",
    "qa:routes": "tsx scripts/list-routes.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "qa:access": "tsx --require ./scripts/register-server-only.cjs scripts/check-access-control.ts",
    "qa:tenant-isolation": "tsx --require ./scripts/register-server-only.cjs scripts/check-tenant-isolation.ts",
    "qa:rls": "tsx --require ./scripts/register-server-only.cjs scripts/check-rls-policies.ts",
    "qa:rls:static": "QA_RLS_STATIC_ONLY=1 tsx --require ./scripts/register-server-only.cjs scripts/check-rls-policies.ts",
    "qa:rls:advisor": "tsx --require ./scripts/register-server-only.cjs scripts/ci-rls-advisor-catalog.ts",
    "qa:ephemeral-seed": "tsx --require ./scripts/register-server-only.cjs scripts/ci-seed-ephemeral-identities.ts",
    "qa:postgrest-reload": "node scripts/ci-reload-postgrest.cjs",
    "qa:ephemeral-app-flow": "tsx --require ./scripts/register-server-only.cjs scripts/ci-ephemeral-app-flow.ts",
    "qa:social-instagram": "tsx scripts/instagram-connection-tests.ts",
    "qa:social-tiktok": "tsx scripts/tiktok-connection-tests.ts",
    "qa:social-youtube": "tsx scripts/youtube-connection-tests.ts",
    "qa:social-x": "tsx scripts/x-connection-tests.ts",
    "qa:social-step4-correction": "tsx scripts/step-4-correction-verification.ts",
    "qa:oauth-access-logs": "tsx scripts/verify-oauth-access-log-protection.ts",
    "qa:social-step5-pages": "tsx scripts/step-5-facebook-page-tests.ts",
    "qa:social-step5-discovery-timeout": "tsx scripts/step-5-discovery-timeout-tests.ts",
    "qa:social-step5-capability": "tsx scripts/step-5-page-capability-tests.ts",
    "qa:social-step5-identity": "tsx scripts/step-5-selected-page-identity-tests.ts",
    "qa:social-step5-canonical": "tsx scripts/step-5-canonical-meta-identity-tests.ts",
    "qa:social-step6-sync": "tsx scripts/step-6-facebook-page-sync-tests.ts",
    "qa:social-step6-routing": "tsx scripts/step-6-facebook-dashboard-routing-tests.ts",
    "qa:social-step6-reauth": "tsx scripts/step-6-meta-reauth-durability-tests.ts",
    "qa:social-step7-analytics": "tsx scripts/step-7-facebook-analytics-tests.ts",
    "qa:social-step8-content": "node --import tsx scripts/step-8-facebook-content-tests.ts",
    "qa:social-step9-competitors": "node --import tsx scripts/step-9-facebook-competitor-tests.ts",
    "qa:brand-selector": "tsx scripts/brand-selector-tests.ts",
    "dev:reset-meta-facebook": "tsx scripts/dev-reset-meta-facebook-connection.ts",
    "worker:social-sync": "tsx scripts/run-social-sync-worker.ts",
    "worker:social-sync:backfill": "tsx scripts/run-facebook-historical-backfill.ts",
    "qa:upmind-webhook": "tsx scripts/upmind-webhook-tests.ts",
    "qa:social-entitlements": "tsx scripts/verify-social-entitlements.ts",
    "qa:social-access-policy": "tsx scripts/verify-social-connection-access-policy.ts",
    "qa:social-lifecycle": "tsx scripts/verify-social-subscription-lifecycle.ts",
    "qa:social-brand-allowance": "tsx scripts/verify-social-brand-allowance.ts",
    "qa:social-entitlement-gates": "tsx scripts/verify-social-entitlement-gates.ts",
    "qa:social-billing-banner": "tsx scripts/verify-social-billing-banner.ts",
    "qa:social-stripe-webhook": "tsx scripts/verify-social-stripe-webhook.ts",
    "qa:social-stripe-addons": "tsx scripts/verify-social-stripe-addons.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
