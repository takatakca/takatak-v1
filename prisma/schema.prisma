// ════════════════════════════════════════════════════════════
// TAKATAK COMMUNITY CONTENT / CONTRIBUTOR MODERATION
// Generic tenant-scoped engine. AHMV is the first publisher.
// Human moderation remains authoritative; community edits never write
// directly to source-of-truth hockey systems.
// ════════════════════════════════════════════════════════════

model ManagedContentItem {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.Uuid
  businessBrandId String?  @db.Uuid
  publisherCode   String
  resourceType    String
  resourceKey     String
  title           String?
  canonicalUrl    String?
  sourceKind      String
  sourceUrl       String?
  snapshot        Json
  editableFields  String[] @default([])
  version         Int      @default(1)
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client            Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand     BusinessBrand?        @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  contributions     ContentContribution[]
  publications      ContentPublication[]

  @@unique([publisherCode, resourceType, resourceKey], map: "managed_content_publisher_resource_key")
  @@index([clientId, publisherCode])
  @@index([businessBrandId, publisherCode])
  @@index([resourceType, resourceKey])
  @@index([lastSyncedAt])
  @@map("managed_content_items")
}

model ContentContribution {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              String   @db.Uuid
  businessBrandId       String?  @db.Uuid
  managedContentItemId  String?  @db.Uuid
  publisherCode         String
  idempotencyKey        String
  resourceType          String
  resourceKey           String
  action                String
  targetUrl             String?
  originalVersion       Int?
  originalSnapshot      Json?
  proposedPatch         Json
  reason                String?
  evidenceUrls          String[] @default([])
  attachmentUrls        String[] @default([])
  contributorProfileId  String?  @db.Uuid
  contributorAuthUserId String?  @db.Uuid
  contributorTier       String   @default("guest")
  priority              String   @default("standard")
  reviewDueAt           DateTime
  status                String   @default("pending_review")
  aiReviewStatus        String   @default("pending")
  aiReview              Json?
  moderatorProfileId    String?  @db.Uuid
  moderatorComment      String?
  reviewedAt            DateTime?
  approvedAt            DateTime?
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand?        @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  managedContentItem ManagedContentItem?   @relation(fields: [managedContentItemId], references: [id], onDelete: SetNull)
  contributor        Profile?              @relation("ContributionContributor", fields: [contributorProfileId], references: [id], onDelete: SetNull)
  moderator          Profile?              @relation("ContributionModerator", fields: [moderatorProfileId], references: [id], onDelete: SetNull)
  events             ContentContributionEvent[]
  publication        ContentPublication?
  pointLedger        ContributionPointLedger[]
  assets             ContributionAsset[]

  @@unique([publisherCode, idempotencyKey], map: "content_contribution_publisher_idempotency_key")
  @@index([clientId, status, priority])
  @@index([businessBrandId, status])
  @@index([publisherCode, status, reviewDueAt])
  @@index([resourceType, resourceKey])
  @@index([contributorProfileId, createdAt])
  @@index([moderatorProfileId, reviewedAt])
  @@map("content_contributions")
}

model ContributionAsset {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.Uuid
  businessBrandId String?  @db.Uuid
  contributionId  String?  @db.Uuid
  publisherCode   String
  storageBucket   String
  storagePath     String
  originalName    String
  mimeType        String
  sizeBytes       Int
  status          String   @default("quarantined")
  expiresAt       DateTime
  approvedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand?       @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  contribution  ContentContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  @@unique([storageBucket, storagePath], map: "contribution_asset_storage_key")
  @@index([clientId, publisherCode, status])
  @@index([businessBrandId, status])
  @@index([contributionId, status])
  @@index([expiresAt, status])
  @@map("contribution_assets")
}

model ContentContributionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  contributionId String   @db.Uuid
  actorProfileId String?  @db.Uuid
  eventType      String
  metadata       Json?
  createdAt      DateTime @default(now())

  contribution ContentContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  actor        Profile?            @relation("ContributionEventActor", fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([contributionId, createdAt])
  @@index([actorProfileId, createdAt])
  @@index([eventType, createdAt])
  @@map("content_contribution_events")
}

model ContentPublication {
  id                   String   @id @default(uuid()) @db.Uuid
  clientId             String   @db.Uuid
  businessBrandId      String?  @db.Uuid
  contributionId       String   @unique @db.Uuid
  managedContentItemId String?  @db.Uuid
  publisherCode        String
  resourceType         String
  resourceKey          String
  patch                Json
  version              Int
  status               String   @default("ready")
  active               Boolean  @default(true)
  acknowledgedAt       DateTime?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand?       @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  contribution       ContentContribution  @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  managedContentItem ManagedContentItem?  @relation(fields: [managedContentItemId], references: [id], onDelete: SetNull)

  @@index([clientId, publisherCode, active])
  @@index([businessBrandId, active])
  @@index([publisherCode, resourceType, resourceKey, active])
  @@index([status, createdAt])
  @@map("content_publications")
}

model ContributorReputation {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @db.Uuid
  profileId          String   @db.Uuid
  publisherCode      String
  points             Int      @default(0)
  submittedCount     Int      @default(0)
  approvedCount      Int      @default(0)
  publishedCount     Int      @default(0)
  rejectedCount      Int      @default(0)
  currentBadge       String   @default("new_contributor")
  lastContributionAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client    Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile   Profile                    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pointLedger  ContributionPointLedger[]
  rewardLedger ContributionRewardLedger[]

  @@unique([clientId, profileId, publisherCode], map: "contributor_reputation_scope_key")
  @@index([clientId, publisherCode, points])
  @@index([profileId, publisherCode])
  @@index([currentBadge])
  @@map("contributor_reputations")
}

model ContributionPointLedger {
  id             String   @id @default(uuid()) @db.Uuid
  reputationId   String   @db.Uuid
  contributionId String?  @db.Uuid
  points         Int
  reason         String
  createdAt      DateTime @default(now())

  reputation   ContributorReputation @relation(fields: [reputationId], references: [id], onDelete: Cascade)
  contribution ContentContribution?  @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  @@unique([reputationId, contributionId, reason], map: "contribution_points_idempotency_key")
  @@index([reputationId, createdAt])
  @@index([contributionId])
  @@map("contribution_point_ledger")
}

model ContributionRewardLedger {
  id              String   @id @default(uuid()) @db.Uuid
  reputationId    String   @db.Uuid
  code            String
  thresholdPoints Int
  units           Int
  status          String   @default("available")
  issuedAt        DateTime @default(now())
  redeemedAt      DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reputation ContributorReputation @relation(fields: [reputationId], references: [id], onDelete: Cascade)

  @@unique([reputationId, code, thresholdPoints], map: "contribution_reward_milestone_key")
  @@index([reputationId, status])
  @@index([code, status])
  @@index([issuedAt])
  @@map("contribution_reward_ledger")
}


// ════════════════════════════════════════════════════════════
// Phase 12 — Leads / FLEXS Module Foundation
// FLEXS is NOT connected. Every "_internal" status is internal
// foundation tracking only — no lead was really imported,
// contacted, converted, or won via any provider or automation.
// ════════════════════════════════════════════════════════════

enum LeadSourceType {
  website_form
  social_media
  local_listing
  referral
  phone_call
  email
  paid_ads
  flexs
  manual
  internal_demo
  future_provider
}

enum LeadProvider {
  flexs
  qmaps
  metricool
  google_business
  manual
  internal_demo
  future_provider
}

enum LeadSourceStatus {
  planned
  active_internal
  paused
  disabled
  archived
}

enum LeadCampaignStatus {
  draft
  planned
  active_internal
  paused
  completed_internal
  archived
}

enum LeadStatus {
  new_internal
  follow_up_planned
  contacted_internal
  qualified_internal
  proposal_planned
  won_internal
  lost_internal
  archived
}

enum LeadPriority {
  low
  normal
  high
  urgent
}

enum PipelineStageStatus {
  active_internal
  paused
  archived
}

enum LeadActivityType {
  note
  follow_up
  call
  email
  meeting
  proposal
  status_change
  internal_reminder
}

enum LeadActivityStatus {
  planned
  completed_internal
  cancelled
  archived
}

/// Where leads come from. "active_internal" = internal foundation source
/// only, never real provider sync.
model LeadSource {
  id              String           @id @default(uuid()) @db.Uuid
  clientId        String           @db.Uuid
  businessBrandId String?          @db.Uuid
  name            String
  type            LeadSourceType   @default(manual)
  provider        LeadProvider     @default(internal_demo)
  status          LeadSourceStatus @default(planned)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  leads         Lead[]
  leadCampaigns LeadCampaign[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([type])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("lead_sources")
}

/// Lead generation campaign. No real ad spend or paid sync exists.
model LeadCampaign {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @db.Uuid
  businessBrandId   String?            @db.Uuid
  leadSourceId      String?            @db.Uuid
  serviceInstanceId String?            @db.Uuid
  name              String
  goal              String?
  status            LeadCampaignStatus @default(draft)
  startsAt          DateTime?
  endsAt            DateTime?
  budgetCents       Int?
  currency          String             @default("CAD")
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand?   @relation(fields: [businessBrandId], references: [id])
  leadSource      LeadSource?      @relation(fields: [leadSourceId], references: [id])
  serviceInstance ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])
  leads           Lead[]
  activities      LeadActivity[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadSourceId])
  @@index([serviceInstanceId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
  @@map("lead_campaigns")
}

/// A lead/contact opportunity. All "_internal" statuses are internal
/// foundation tracking — no external contact or real conversion happened.
model Lead {
  id                String       @id @default(uuid()) @db.Uuid
  clientId          String       @db.Uuid
  businessBrandId   String?      @db.Uuid
  leadSourceId      String?      @db.Uuid
  leadCampaignId    String?      @db.Uuid
  name              String?
  email             String?
  phone             String?
  company           String?
  message           String?
  status            LeadStatus   @default(new_internal)
  priority          LeadPriority @default(normal)
  valueCents        Int?
  currency          String       @default("CAD")
  assignedProfileId String?      @db.Uuid
  followUpAt        DateTime?
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  leadSource      LeadSource?    @relation(fields: [leadSourceId], references: [id])
  leadCampaign    LeadCampaign?  @relation(fields: [leadCampaignId], references: [id])
  assignedProfile Profile?       @relation("AssignedLeads", fields: [assignedProfileId], references: [id])
  activities      LeadActivity[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadSourceId])
  @@index([leadCampaignId])
  @@index([assignedProfileId])
  @@index([status])
  @@index([priority])
  @@index([followUpAt])
  @@index([createdAt])
  @@map("leads")
}

/// Pipeline stage configuration per client/brand. Foundation config only.
model LeadPipelineStage {
  id              String              @id @default(uuid()) @db.Uuid
  clientId        String              @db.Uuid
  businessBrandId String?             @db.Uuid
  name            String
  status          PipelineStageStatus @default(active_internal)
  order           Int                 @default(0)
  color           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([order])
  @@index([createdAt])
  @@map("lead_pipeline_stages")
}

/// Lead activity/follow-up history. "completed_internal" is internal
/// tracking only — no real call, email, or automation ran.
model LeadActivity {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        String             @db.Uuid
  businessBrandId String?            @db.Uuid
  leadId          String?            @db.Uuid
  leadCampaignId  String?            @db.Uuid
  type            LeadActivityType   @default(note)
  status          LeadActivityStatus @default(planned)
  title           String
  note            String?
  dueAt           DateTime?
  completedAt     DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id])
  leadCampaign  LeadCampaign?  @relation(fields: [leadCampaignId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadId])
  @@index([leadCampaignId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
  @@map("lead_activities")
}

model MasterIdentity {
  id                   String    @id @default(uuid()) @db.Uuid
  profileId            String?   @unique @db.Uuid
  authUserId           String?   @unique @db.Uuid
  firstName            String?
  lastName             String?
  primaryEmail         String?   @unique
  primaryEmailVerified Boolean   @default(false)
  primaryPhone         String?   @unique
  primaryPhoneVerified Boolean   @default(false)
  locale               String?
  accountStatus        String?
  registeredAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile             Profile?                     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  sourceProfiles      SourceProfile[]
  addresses           SourceAddress[]
  paymentSummaries    SourcePaymentSummary[]
  events              SourceSynchronizationEvent[]
  hockeyMemberships   HockeyMembership[]
  hockeyStripeEvents  HockeyStripeWebhookEvent[]

  experienceLaunchCodes ExperienceLaunchCode[]
  billingInvoiceRequests BillingInvoiceRequest[]
  @@index([primaryEmail])
  @@index([primaryPhone])
  @@map("master_identities")
  hockeyParentPreferences HockeyParentTeamPreference[]
  hockeyPremiumGrants       HockeyPremiumGrant[]
  hockeyDeliveryJobs        HockeyDeliveryJob[]
  hockeyCalendarConnections HockeyCalendarConnection[]
  hockeyCalendarOAuthStates HockeyCalendarOAuthState[]
  hockeyFamiliesOwned       HockeyFamily[] @relation("HockeyFamilyOwner")
  hockeyFamilyMemberships   HockeyFamilyMember[] @relation("HockeyFamilyLinkedIdentity")
  hockeyFamilyInvitesCreated HockeyFamilyInvite[] @relation("HockeyFamilyInviteCreator")
  hockeyFamilyInvitesAccepted HockeyFamilyInvite[] @relation("HockeyFamilyInviteAccepted")
  hockeyFamilyPlansCreated    HockeyFamilyEventPlan[] @relation("HockeyFamilyPlanCreator")
  hockeyFamilyRsvpsUpdated     HockeyFamilyEventRsvp[] @relation("HockeyFamilyRsvpUpdater")
  hockeyTravelProfiles      HockeyTravelProfile[]
}

/// Person/family hockey membership owned by the TAKATAK master identity.
/// Entitlements are derived server-side from planCode and status; they are not
/// writable booleans on this row. sourceApplication keeps the model reusable
/// across future hockey associations without mixing subscriptions.
model HockeyMembership {
  id                     String                 @id @default(uuid()) @db.Uuid
  identityId             String                 @db.Uuid
  sourceApplication      String                 @default("ahmverdun")
  status                 HockeyMembershipStatus @default(incomplete)
  planCode               String
  planName               String
  provider               String                 @default("stripe")
  externalCustomerId     String?
  externalSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, sourceApplication])
  @@index([status])
  @@index([planCode])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@map("hockey_memberships")
}

/// Idempotency ledger for hockey Stripe events. Raw webhook payloads are never
/// stored here.
/// Latest normalized public AHMV schedule snapshot consumed by AHMV Phone/SMS/Voice.
/// This is public schedule data only: no roster, child or family data belongs here.
model AhmvScheduleSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  tenant          String   @unique @default("ahmverdun")
  status          String
  sourceUrl       String
  sourceUpdatedAt DateTime
  events          Json
  eventCount      Int      @default(0)
  contentHash     String
  receivedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceUpdatedAt])
  @@map("ahmv_schedule_snapshots")
}

model HockeyStripeWebhookEvent {
  id                String          @id @default(uuid()) @db.Uuid
  stripeEventId     String          @unique
  type              String
  identityId        String?         @db.Uuid
  sourceApplication String          @default("ahmverdun")
  createdAt         DateTime        @default(now())

  identity MasterIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([identityId])
  @@index([sourceApplication])
  @@map("hockey_stripe_webhook_events")
}

model SourceProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  identityId         String   @db.Uuid
  sourceApplication  String
  externalUserId     String
  collectedFields    Json
  verifiedFields     String[] @default([])
  consentRecords     Json?
  accountStatus      String?
  lastSynchronizedAt DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  identity         MasterIdentity               @relation(fields: [identityId], references: [id], onDelete: Cascade)
  addresses        SourceAddress[]
  paymentSummaries SourcePaymentSummary[]
  events           SourceSynchronizationEvent[]

  @@unique([sourceApplication, externalUserId])
  @@index([identityId])
  @@index([sourceApplication])
  @@map("source_profiles")
}

model SourceAddress {
  id                String   @id @default(uuid()) @db.Uuid
  identityId        String   @db.Uuid
  sourceProfileId   String   @db.Uuid
  externalAddressId String
  addressType       String
  line1             String
  line2             String?
  city              String
  province          String?
  postalCode        String?
  country           String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  identity      MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sourceProfile SourceProfile  @relation(fields: [sourceProfileId], references: [id], onDelete: Cascade)

  @@unique([sourceProfileId, externalAddressId])
  @@index([identityId])
  @@map("source_addresses")
}

model SourcePaymentSummary {
  id                      String   @id @default(uuid()) @db.Uuid
  identityId              String   @db.Uuid
  sourceProfileId         String   @db.Uuid
  sourceApplication       String
  bookingNumber           String
  status                  String
  amountMinor             Int
  refundedAmountMinor     Int?
  currency                String
  transactionDate         DateTime
  stripeCustomerReference String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  identity      MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sourceProfile SourceProfile  @relation(fields: [sourceProfileId], references: [id], onDelete: Cascade)

  @@unique([sourceApplication, bookingNumber])
  @@index([identityId, transactionDate])
  @@map("source_payment_summaries")
}

model SourceSynchronizationEvent {
  id                String    @id @default(uuid()) @db.Uuid
  eventId           String    @unique
  eventType         String
  sourceApplication String
  sourceProfileId   String?   @db.Uuid
  identityId        String?   @db.Uuid
  payloadHash       String
  payload           Json?
  responsePayload   Json?
  status            String    @default("RECEIVED")
  errorMessage      String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  identity      MasterIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  sourceProfile SourceProfile?  @relation(fields: [sourceProfileId], references: [id], onDelete: SetNull)

  @@index([sourceApplication, createdAt])
  @@index([status])
  @@map("source_synchronization_events")
}

model MasterMerchant {
  id           String   @id @default(uuid()) @db.Uuid
  legalName    String?
  primaryEmail String?
  primaryPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceMerchants SourceMerchant[]

  @@index([primaryEmail])
  @@index([primaryPhone])
  @@map("master_merchants")
}

model SourceMerchant {
  id                  String   @id @default(uuid()) @db.Uuid
  merchantId          String   @db.Uuid
  sourceApplication   String
  externalMerchantId  String
  ownerExternalUserId String?
  storeName           String
  storeSlug           String?
  collectedFields     Json
  marketplaceStatus   String?
  subscriptionStatus  String?
  subscriptionPlan    String?
  lastSynchronizedAt  DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  merchant MasterMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([sourceApplication, externalMerchantId])
  @@index([merchantId])
  @@index([sourceApplication, lastSynchronizedAt])
  @@map("source_merchants")
}

// ════════════════════════════════════════════════════════════
// GROUPE TAKATAK — configurable product / entitlement catalog
// Prices and product entitlements are data, never application constants.
// ════════════════════════════════════════════════════════════

model ProductCatalog {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  status      String               @default("active")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  plans        ProductPlan[]
  entitlements ProductEntitlement[]

  @@index([status])
  @@map("product_catalog")
}

model ProductPlan {
  id                String                   @id @default(uuid()) @db.Uuid
  productId         String                   @db.Uuid
  code              String
  legacyCode        String?
  name              String
  status            String                   @default("active")
  selfServeEligible Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  product      ProductCatalog             @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices       ProductPrice[]
  entitlements ProductPlanEntitlement[]

  @@unique([productId, code])
  @@unique([productId, legacyCode])
  @@index([status])
  @@map("product_plans")
}

model ProductPrice {
  id              String      @id @default(uuid()) @db.Uuid
  planId          String      @db.Uuid
  currency        String      @default("CAD")
  unitAmountMinor Int
  billingInterval String
  intervalCount   Int         @default(1)
  provider        String      @default("stripe")
  providerPriceId String?     @unique
  active          Boolean     @default(true)
  startsAt        DateTime    @default(now())
  endsAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  plan ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, active])
  @@index([currency])
  @@map("product_prices")
}

model ProductEntitlement {
  id          String                   @id @default(uuid()) @db.Uuid
  productId   String                   @db.Uuid
  code        String
  name        String
  description String?
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  product ProductCatalog            @relation(fields: [productId], references: [id], onDelete: Cascade)
  plans   ProductPlanEntitlement[]

  @@unique([productId, code])
  @@index([active])
  @@map("product_entitlements")
}

model ProductPlanEntitlement {
  planId        String @db.Uuid
  entitlementId String @db.Uuid

  plan        ProductPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement ProductEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@id([planId, entitlementId])
  @@map("product_plan_entitlements")
}

/// One-time, short-lived browser handoff from TAKATAK Auth to an independent
/// product experience. Only a SHA-256 hash of the launch code is persisted.
model ExperienceLaunchCode {
  id              String    @id @default(uuid()) @db.Uuid
  codeHash        String    @unique
  identityId      String    @db.Uuid
  productCode     String
  entitlementCode String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, productCode, entitlementCode])
  @@index([expiresAt])
  @@map("experience_launch_codes")
}


// Voluntary product-development support. This is intentionally separate from
// membership subscriptions and does not imply charitable/tax receipt status.
model SupportContribution {
  id                       String   @id @default(uuid()) @db.Uuid
  customerId               String?  @db.Uuid
  organizationId           String?  @db.Uuid
  productCode              String   @default("ahmv")
  amountMinor              Int
  currency                 String   @default("CAD")
  frequency                String   @default("one_time")
  provider                 String   @default("stripe")
  stripePaymentIntentId    String?  @unique
  stripeSubscriptionId     String?  @unique
  status                   String
  source                   String?
  campaign                 String?
  feesMinor                Int      @default(0)
  netAmountMinor           Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([productCode, status, createdAt])
  @@index([customerId])
  @@index([organizationId])
  @@map("support_contributions")
}

enum AdsPublisherStatus {
  active
  paused
  retired
}

enum AdsPlacementStatus {
  active
  paused
  retired
}

enum AdsCampaignStatus {
  draft
  active
  paused
  completed
  canceled
}

enum AdsCampaignScope {
  single_site
  local_network
  max_lead_pro
}

enum AdsPricingModel {
  cpm
  cpc
  cpl
  fixed
}

enum AdsCreativeStatus {
  draft
  active
  paused
  rejected
  archived
}

enum AdsEventType {
  impression
  click
  lead
  call
  form_submit
  conversion
}

/// Public site/application participating in the TAKATAK-owned ad network.
/// V1 publishers are platform-managed; external publisher revenue-share can be
/// added later without changing advertiser ownership.
model AdPublisher {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique
  name      String
  domain    String
  category  String?
  country   String             @default("Canada")
  region    String?
  city      String?
  postalPrefix String?
  allowedOrigins String[]      @default([])
  status    AdsPublisherStatus @default(active)
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  placements AdPlacement[]

  @@index([status])
  @@index([domain])
  @@map("ad_publishers")
}

/// Named inventory slot embedded on a TAKATAK publisher.
model AdPlacement {
  id             String             @id @default(uuid()) @db.Uuid
  publisherId    String             @db.Uuid
  code           String
  name           String
  pagePattern    String?
  format         String             @default("display")
  width          Int?
  height         Int?
  device         String?
  status         AdsPlacementStatus @default(active)
  floorCpmCents  Int                @default(0)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  publisher          AdPublisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  campaignPlacements AdCampaignPlacement[]
  events             AdEvent[]

  @@unique([publisherId, code])
  @@index([code])
  @@index([status])
  @@map("ad_placements")
}

/// ADS subscription is intentionally separate from the Social subscription.
/// Entitlements are derived server-side from planCode + lifecycle status.
model AdSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  clientId               String             @unique @db.Uuid
  status                 SubscriptionStatus @default(trial)
  planCode               String?
  planName               String?
  provider               String?
  externalCustomerId     String?
  externalSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([planCode])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@map("ad_subscriptions")
}

/// Advertiser campaign. It is separate from the existing Social Campaign model.
model AdCampaign {
  id              String            @id @default(uuid()) @db.Uuid
  clientId        String            @db.Uuid
  businessBrandId String?           @db.Uuid
  name            String
  status          AdsCampaignStatus @default(draft)
  scope           AdsCampaignScope
  objective       String?
  pricingModel    AdsPricingModel   @default(fixed)
  budgetCents     Int
  dailyBudgetCents Int?
  spentCents      Int               @default(0)
  bidCents        Int?
  currency        String            @default("CAD")
  startsAt        DateTime?
  endsAt          DateTime?
  targeting       Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand?        @relation(fields: [businessBrandId], references: [id], onDelete: SetNull)
  creatives          AdCreative[]
  placements         AdCampaignPlacement[]
  events             AdEvent[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([scope])
  @@index([startsAt, endsAt])
  @@map("ad_campaigns")
}

model AdCreative {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @db.Uuid
  name           String
  headline       String
  body           String?
  callToAction   String?
  destinationUrl String
  imageUrl       String?
  status         AdsCreativeStatus @default(draft)
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   AdEvent[]

  @@index([campaignId, status])
  @@map("ad_creatives")
}

model AdCampaignPlacement {
  campaignId  String   @db.Uuid
  placementId String   @db.Uuid
  createdAt   DateTime @default(now())

  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@id([campaignId, placementId])
  @@index([placementId])
  @@map("ad_campaign_placements")
}

/// Event ledger intentionally stores no raw IP address, email, phone number or
/// browser fingerprint. Lead/call conversion linkage is added server-to-server
/// through FLEXS in a later integration layer.
model AdEvent {
  id           String       @id @default(uuid()) @db.Uuid
  campaignId   String       @db.Uuid
  creativeId   String?      @db.Uuid
  placementId  String       @db.Uuid
  type         AdsEventType
  dedupeKey    String?      @unique
  occurredAt   DateTime     @default(now())
  country      String?
  region       String?
  city         String?
  postalPrefix String?
  locale       String?
  metadata     Json?

  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative  AdCreative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([creativeId, occurredAt])
  @@index([placementId, occurredAt])
  @@index([type, occurredAt])
  @@map("ad_events")
}


model HockeyParentTeamPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  identityId            String   @db.Uuid
  sourceApplication     String   @default("ahmverdun")
  teamId                String
  smsReminders          Boolean  @default(false)
  calendarSync          Boolean  @default(false)
  departureAlerts       Boolean  @default(false)
  arrivalBufferMinutes  Int      @default(30)
  smsConsentAt          DateTime?
  calendarConsentAt     DateTime?
  departureConsentAt    DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, sourceApplication, teamId])
  @@index([identityId, sourceApplication])
  @@index([sourceApplication, teamId])
  @@map("hockey_parent_team_preferences")
}


model HockeyPremiumGrant {
  id                String   @id @default(uuid()) @db.Uuid
  identityId        String   @db.Uuid
  sourceApplication String   @default("ahmverdun")
  grantType         String   @default("supporter_thank_you")
  sourceReference   String
  status            String   @default("available")
  planCode          String   @default("hockey_member_weekly_10")
  grantedWeeks      Int      @default(4)
  activatedAt       DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([sourceApplication, sourceReference])
  @@index([identityId, sourceApplication, status])
  @@index([identityId, expiresAt])
  @@map("hockey_premium_grants")
}


model HockeyTeamEvent {
  id                String   @id @default(uuid()) @db.Uuid
  sourceApplication String   @default("ahmverdun")
  sourceEventId     String
  teamId            String
  eventType         String
  title             String
  startsAt          DateTime
  endsAt            DateTime?
  timezone          String   @default("America/Toronto")
  arenaName         String?
  arenaAddress      String?
  arenaLatitude     Float?
  arenaLongitude    Float?
  status            String   @default("confirmed")
  sourceUrl         String?
  sourceUpdatedAt   DateTime
  payloadHash       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deliveryJobs     HockeyDeliveryJob[]
  calendarMappings HockeyCalendarEventMapping[]
  familyPlans      HockeyFamilyEventPlan[]
  familyRsvps      HockeyFamilyEventRsvp[]

  @@unique([sourceApplication, sourceEventId])
  @@index([sourceApplication, teamId, startsAt])
  @@index([startsAt, status])
  @@map("hockey_team_events")
}


model HockeyDeliveryJob {
  id             String   @id @default(uuid()) @db.Uuid
  identityId     String   @db.Uuid
  teamEventId    String   @db.Uuid
  kind           String
  status         String   @default("queued")
  scheduledAt    DateTime
  dedupeKey      String   @unique
  eventRevision  String
  attemptCount   Int      @default(0)
  lockedAt       DateTime?
  completedAt    DateTime?
  lastErrorCode  String?
  lastErrorMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  identity  MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  teamEvent HockeyTeamEvent @relation(fields: [teamEventId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([identityId, status])
  @@index([teamEventId, kind])
  @@map("hockey_delivery_jobs")
}


model HockeyCalendarConnection {
  id                   String   @id @default(uuid()) @db.Uuid
  identityId           String   @db.Uuid
  sourceApplication    String   @default("ahmverdun")
  provider             String   @default("google")
  status               String   @default("pending")
  externalAccountId    String?
  displayName          String?
  calendarId           String   @default("primary")
  scopes               String[] @default([])
  tokenCiphertext      String?
  tokenIv              String?
  tokenAuthTag         String?
  tokenKeyVersion      Int      @default(1)
  accessTokenExpiresAt DateTime?
  connectedAt          DateTime?
  lastValidatedAt      DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  mappings HockeyCalendarEventMapping[]

  @@unique([identityId, sourceApplication, provider])
  @@index([status])
  @@index([identityId, status])
  @@map("hockey_calendar_connections")
}


model HockeyCalendarOAuthState {
  id                   String   @id @default(uuid()) @db.Uuid
  identityId           String   @db.Uuid
  sourceApplication    String   @default("ahmverdun")
  provider             String   @default("google")
  stateHash            String   @unique
  verifierCiphertext   String
  verifierIv           String
  verifierAuthTag      String
  verifierKeyVersion   Int      @default(1)
  status               String   @default("pending")
  returnPath           String
  expiresAt            DateTime
  consumedAt           DateTime?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([expiresAt])
  @@map("hockey_calendar_oauth_states")
}


model HockeyCalendarEventMapping {
  id              String   @id @default(uuid()) @db.Uuid
  connectionId    String   @db.Uuid
  teamEventId     String   @db.Uuid
  providerEventId String
  eventRevision   String
  status          String   @default("active")
  lastSyncedAt    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection HockeyCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teamEvent  HockeyTeamEvent @relation(fields: [teamEventId], references: [id], onDelete: Cascade)

  @@unique([connectionId, teamEventId])
  @@index([providerEventId])
  @@index([teamEventId])
  @@map("hockey_calendar_event_mappings")
}


model HockeyPublicTeam {
  id                String   @id @default(uuid()) @db.Uuid
  sourceApplication String   @default("ahmverdun")
  teamId            String
  categorySlug      String?
  level             String?
  name              String
  seasonCode        String?
  active            Boolean  @default(true)
  sourceUpdatedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  selections HockeyFamilyTeamSelection[]

  @@unique([sourceApplication, teamId])
  @@index([sourceApplication, active])
  @@index([categorySlug, level])
  @@map("hockey_public_teams")
}


model HockeyFamily {
  id                String   @id @default(uuid()) @db.Uuid
  ownerIdentityId   String   @db.Uuid
  sourceApplication String   @default("ahmverdun")
  displayName       String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner      MasterIdentity            @relation("HockeyFamilyOwner", fields: [ownerIdentityId], references: [id], onDelete: Cascade)
  members    HockeyFamilyMember[]
  selections HockeyFamilyTeamSelection[]
  invites     HockeyFamilyInvite[]
  eventPlans  HockeyFamilyEventPlan[]
  eventRsvps   HockeyFamilyEventRsvp[]

  @@unique([ownerIdentityId, sourceApplication])
  @@index([status])
  @@map("hockey_families")
}


model HockeyFamilyMember {
  id               String   @id @default(uuid()) @db.Uuid
  familyId         String   @db.Uuid
  linkedIdentityId String?  @db.Uuid
  memberCode       String   @unique
  memberType       String
  displayName      String
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  family         HockeyFamily    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  linkedIdentity MasterIdentity? @relation("HockeyFamilyLinkedIdentity", fields: [linkedIdentityId], references: [id], onDelete: SetNull)
  selections     HockeyFamilyTeamSelection[]
  plansAsChild   HockeyFamilyEventPlan[] @relation("HockeyFamilyPlanChild")
  plansAsDriver  HockeyFamilyEventPlan[] @relation("HockeyFamilyPlanDriver")
  eventRsvps     HockeyFamilyEventRsvp[]

  @@unique([familyId, linkedIdentityId])
  @@index([familyId, memberType, status])
  @@index([linkedIdentityId, status])
  @@map("hockey_family_members")
}


model HockeyFamilyTeamSelection {
  id            String   @id @default(uuid()) @db.Uuid
  familyId      String   @db.Uuid
  memberId      String   @db.Uuid
  publicTeamId  String   @db.Uuid
  selectionType String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family     HockeyFamily       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member     HockeyFamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  publicTeam HockeyPublicTeam   @relation(fields: [publicTeamId], references: [id], onDelete: Restrict)

  @@unique([memberId, publicTeamId, selectionType])
  @@index([familyId, selectionType])
  @@index([publicTeamId])
  @@map("hockey_family_team_selections")
}


model HockeyFamilyInvite {
  id                 String   @id @default(uuid()) @db.Uuid
  familyId           String   @db.Uuid
  inviterIdentityId  String   @db.Uuid
  acceptedIdentityId String?  @db.Uuid
  tokenHash          String   @unique
  role               String   @default("guardian")
  status             String   @default("pending")
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  family           HockeyFamily    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviterIdentity  MasterIdentity  @relation("HockeyFamilyInviteCreator", fields: [inviterIdentityId], references: [id], onDelete: Cascade)
  acceptedIdentity MasterIdentity? @relation("HockeyFamilyInviteAccepted", fields: [acceptedIdentityId], references: [id], onDelete: SetNull)

  @@index([familyId, status, expiresAt])
  @@index([inviterIdentityId, status])
  @@index([acceptedIdentityId])
  @@map("hockey_family_invites")
}


model HockeyFamilyEventPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  familyId            String   @db.Uuid
  teamEventId         String   @db.Uuid
  childMemberId       String   @db.Uuid
  driverMemberId      String   @db.Uuid
  createdByIdentityId String   @db.Uuid
  status              String   @default("planned")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  family    HockeyFamily       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  teamEvent HockeyTeamEvent    @relation(fields: [teamEventId], references: [id], onDelete: Cascade)
  child     HockeyFamilyMember @relation("HockeyFamilyPlanChild", fields: [childMemberId], references: [id], onDelete: Cascade)
  driver    HockeyFamilyMember @relation("HockeyFamilyPlanDriver", fields: [driverMemberId], references: [id], onDelete: Cascade)
  createdBy MasterIdentity     @relation("HockeyFamilyPlanCreator", fields: [createdByIdentityId], references: [id], onDelete: Cascade)

  @@unique([familyId, teamEventId, childMemberId])
  @@index([familyId, status])
  @@index([teamEventId, status])
  @@index([driverMemberId, status])
  @@map("hockey_family_event_plans")
}


model HockeyFamilyEventRsvp {
  id                  String   @id @default(uuid()) @db.Uuid
  familyId            String   @db.Uuid
  teamEventId         String   @db.Uuid
  childMemberId       String   @db.Uuid
  updatedByIdentityId String   @db.Uuid
  status              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  family    HockeyFamily       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  teamEvent HockeyTeamEvent    @relation(fields: [teamEventId], references: [id], onDelete: Cascade)
  child     HockeyFamilyMember @relation(fields: [childMemberId], references: [id], onDelete: Cascade)
  updatedBy MasterIdentity     @relation("HockeyFamilyRsvpUpdater", fields: [updatedByIdentityId], references: [id], onDelete: Cascade)

  @@unique([familyId, teamEventId, childMemberId])
  @@index([familyId, status])
  @@index([teamEventId, status])
  @@map("hockey_family_event_rsvps")
}


model HockeyTravelProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  identityId         String   @db.Uuid
  sourceApplication  String   @default("ahmverdun")
  status             String   @default("active")
  originLabel        String?
  originCiphertext   String
  originIv           String
  originAuthTag      String
  originKeyVersion   Int      @default(1)
  departureConsentAt DateTime
  lastUsedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  identity MasterIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, sourceApplication])
  @@index([status])
  @@index([identityId, status])
  @@map("hockey_travel_profiles")
}


// ════════════════════════════════════════════════════════════
// GROUPE TAKATAK Billing — ecosystem invoice request queue.
// Every TAKATAK app feeds invoice requests here; a platform OWNER submits
// them to the independent Facturations service, which creates a DRAFT only.
// See docs/TAKATAK_BILLING_FACTURATIONS_FOUNDATION.md.
// ════════════════════════════════════════════════════════════

enum BillingInvoiceRequestStatus {
  pending
  submitting
  submitted
  failed
  rejected
  needs_reconciliation
  cancelled
}

model BillingInvoiceRequest {
  id                     String                      @id @default(uuid()) @db.Uuid
  /// Feeding app code (src/lib/billing/invoices/source-apps.ts).
  sourceApp              String
  /// Stable reference inside the feeding app. Unique per sourceApp.
  sourceReference        String
  clientId               String?                     @db.Uuid
  masterIdentityId       String?                     @db.Uuid
  /// Facturations Idempotency-Key derived from this row id: stable for every retry
  /// of this request, and never shared with another TAKATAK install.
  idempotencyKey         String                      @unique
  /// Validated Facturations DraftInput. Immutable after insert (DB trigger).
  draft                  Json
  draftHash              String
  currency               String                      @default("CAD")
  /// Local estimate only; Facturations recalculates the authoritative draft.
  estimatedTotalCents    BigInt
  status                 BillingInvoiceRequestStatus @default(pending)
  facturationsDraftId    String?                     @unique @db.Uuid
  facturationsTotalCents BigInt?
  submitAttempts         Int                         @default(0)
  lastErrorCode          String?
  lastAttemptAt          DateTime?
  submittedAt            DateTime?
  cancelledAt            DateTime?
  createdByProfileId     String?                     @db.Uuid
  submittedByProfileId   String?                     @db.Uuid
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  checkoutSessions BillingInvoiceCheckoutSession[]
  masterIdentity MasterIdentity? @relation(fields: [masterIdentityId], references: [id], onDelete: SetNull)
  createdBy      Profile?        @relation("BillingInvoiceRequestCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  submittedBy    Profile?        @relation("BillingInvoiceRequestSubmittedBy", fields: [submittedByProfileId], references: [id], onDelete: SetNull)

  @@unique([sourceApp, sourceReference])
  @@index([status, createdAt])
  @@index([clientId])
  @@index([masterIdentityId])
  @@index([createdByProfileId])
  @@index([submittedByProfileId])
  @@map("billing_invoice_requests")
}

/// GROUPE TAKATAK Billing — Stripe Checkout sessions a client opened to pay a
/// Facturations invoice. One open session per invoice and amount is reused;
/// a completed one blocks a second payment; an outdated one is expired first.
model BillingInvoiceCheckoutSession {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @db.Uuid
  clientId        String   @db.Uuid
  issuedInvoiceId String   @db.Uuid
  stripeSessionId String   @unique
  amountCents     BigInt
  createdAt       DateTime @default(now())

  request BillingInvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("billing_invoice_checkout_sessions")
}

