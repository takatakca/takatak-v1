// TAKATAK User Official Dashboard V1 — Phase 4 core schema.
// 12 core SaaS models (of the 30 planned). Remaining models arrive with
// their module phases. Supabase-style pooled + direct URLs.
//
// HONESTY RULES (enforced in seed + app code):
// - IntegrationAccount.status is never seeded as "connected".
// - ServiceInstance.provider never implies a connected integration.
// - No credentials, tokens, or realistic external IDs in seed data.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

// MochaHost runtime client: no Rust query engine (CloudLinux panics with
// "timer has gone away" and cannot fork prisma generate).
generator mochaClient {
  provider   = "prisma-client-js"
  output     = "./generated"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum PlatformRole {
  user
  admin
  owner
}

enum WorkspaceRole {
  owner
  admin
  manager
  editor
  staff
  viewer
}

enum ProfileStatus {
  active
  invited
  disabled
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum MembershipStatus {
  active
  suspended
}

enum PermissionKey {
  view_dashboard
  manage_clients
  manage_brands
  manage_services
  manage_integrations
  manage_jobs
  view_team
  invite_users
  manage_users
  suspend_users
  delete_users
  manage_roles
  manage_permissions
  view_activity_log
  view_admin
  manage_settings
  create_content
  edit_content
  approve_content
  view_reports
  view_social
  manage_social_accounts
}

enum ClientStatus {
  prospect
  active
  paused
  archived
}

enum SubscriptionStatus {
  /// Checkout started; payment not confirmed.
  incomplete
  trial
  active
  /// Renewal charge failed; retries underway. Paid access stays.
  past_due
  /// Extra retry window. Paid access stays.
  grace_period
  canceled
  expired
  /// Permanent Free Social plan. Not a trial. Fallback after expire / failed retries.
  free
  /// Billing intentionally paused.
  paused
  /// Admin / fraud lock. No Social access.
  suspended
}

enum BrandStatus {
  draft
  active
  paused
  /// Hidden by Social plan allowance. Not deleted. Restore on upgrade or owner pick.
  frozen
  archived
}

enum LocationStatus {
  draft
  active
  paused
  archived
}

enum ServiceType {
  social_media
  web_hosting
  domain
  local_listings
  leads
  ai_studio
  reports
  billing
  support
  custom
}

enum Provider {
  metricool
  upmind
  tryholo
  openai
  qmaps
  flexs
  stripe
  supabase
  internal
}

enum ServiceStatus {
  planned
  pending_setup
  active
  paused
  failed
  cancelled
}

enum IntegrationStatus {
  not_connected
  planned
  disabled
  pending_credentials
  connected
  error
  expired
}

enum IntegrationEventStatus {
  received
  processed
  failed
  ignored
}

enum JobType {
  create_campaign
  generate_content
  approve_post
  send_to_metricool
  sync_analytics
  generate_report
  send_notification
  provision_hosting
  sync_domain_status
  retry_integration_task
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
  retrying
  planned
}

enum JobLogLevel {
  info
  warning
  error
  debug
}

enum ReportType {
  social_media
  web_hosting
  local_listings
  leads
  monthly_business
  client_summary
}

enum ReportStatus {
  draft
  ready
  sent
  archived
}

enum NotificationType {
  approval_needed
  report_ready
  invoice_due
  integration_error
  job_failed
  support_reply
  service_renewal
  system
}

enum NotificationStatus {
  unread
  read
  archived
}

// ============================================================
// SOCIAL ONBOARDING ENUMS — ADD THIS BLOCK ABOVE model Profile
// ============================================================

enum SocialOnboardingPersona {
  creator
  company_manager
  freelancer
  agency
}

enum SocialOnboardingTeamMode {
  solo
  team
}

enum SocialOnboardingGoal {
  planning
  analytics
  smartlinks
  inbox
}

enum SocialOnboardingStatus {
  in_progress
  completed
  skipped
}

// ── Models ──────────────────────────────────────────────────

/// App profile mapped to a Supabase Auth user (does NOT replace Supabase Auth).
model Profile {
  id          String        @id @default(uuid()) @db.Uuid
  authUserId  String        @unique @db.Uuid
  email       String        @unique
  firstName   String?
  lastName    String?
  displayName String?
  role        PlatformRole  @default(user)
  status      ProfileStatus @default(invited)
  /// Upmind billing customer id. TAKATAK remains the login; this only links checkout.
  upmindClientId String?    @unique
  phone              String?   @unique
  otpHash            String?
  otpExpiresAt       DateTime?
  lastOtpRequestedAt DateTime?
  otpAttemptCount    Int       @default(0)
  /// UI language for Account settings. English is the only shipped locale.
  language               String   @default("en")
  timezone               String   @default("America/Toronto")
  /// sunday | monday
  weekStartsOn           String   @default("sunday")
  monthlySummaryEnabled  Boolean  @default(true)
  monthlySummaryEmail    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships              ClientMembership[]
  sentInvitations          UserInvitation[]           @relation("InvitedByProfile")
  assignedClients          Client[]                   @relation("AssignedAdmin")
  notifications            Notification[]
  auditLogs                AuditLog[]
  requestedApprovals       Approval[]                 @relation("RequestedApprovals")
  reviewedApprovals        Approval[]                 @relation("ReviewedApprovals")
  assignedLeads            Lead[]                     @relation("AssignedLeads")
  createdSocialConnections SocialProviderConnection[] @relation("SocialConnectionCreatedBy")
  createdSocialOAuthStates SocialOAuthState[]         @relation("SocialOAuthCreatedBy")
  socialBrandAssignments   SocialBrandAccountAssignment[] @relation("SocialBrandAssignmentAssignedBy")
  socialOnboarding         SocialOnboarding?

  @@map("profiles")
}

model SocialOnboarding {
  id          String                    @id @default(uuid()) @db.Uuid
  profileId   String                    @unique @db.Uuid
  persona     SocialOnboardingPersona?
  teamMode    SocialOnboardingTeamMode?
  goals       SocialOnboardingGoal[]    @default([])
  status      SocialOnboardingStatus    @default(in_progress)
  lastStep    Int                       @default(1)
  startedAt   DateTime                  @default(now())
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("social_onboarding")
}

/// A TAKATAK client account (tenant root).
model Client {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  email             String?
  phone             String?
  companyName       String?
  status            ClientStatus @default(prospect)
  planName          String?
  timezone          String       @default("America/Toronto")
  vatTaxId          String?
  billingAddress    String?
  billingCountry    String       @default("Canada")
  invoiceEmails     String[]     @default([])
  assignedProfileId String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assignedProfile           Profile?                   @relation("AssignedAdmin", fields: [assignedProfileId], references: [id])
  memberships               ClientMembership[]
  subscription              ClientSubscription?
  userInvitations           UserInvitation[]
  businessBrands            BusinessBrand[]
  serviceInstances          ServiceInstance[]
  integrationAccounts       IntegrationAccount[]
  jobs                      Job[]
  reports                   Report[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  socialAccounts            SocialAccount[]
  socialProviderConnections SocialProviderConnection[]
  socialBrandAssignments    SocialBrandAccountAssignment[]
  socialOAuthStates         SocialOAuthState[]
  socialAccountSyncStates   SocialAccountSyncState[]
  campaigns                 Campaign[]
  socialPosts               SocialPost[]
  socialContentItems        SocialContentItem[]
  socialCompetitorTracks    SocialCompetitorTrack[]
  socialCompetitorSnapshots SocialCompetitorSnapshot[]
  approvals                 Approval[]
  socialAnalyticsDaily      SocialAnalyticsDaily[]
  socialAdAccounts          SocialAdAccount[]
  socialAdAnalyticsDaily    SocialAdAnalyticsDaily[]
  domainAssets              DomainAsset[]
  hostingServices           HostingService[]
  provisioningSteps         ProvisioningStep[]
  brandVoices               BrandVoice[]
  aiContentJobs             AiContentJob[]
  savedAiOutputs            SavedAiOutput[]
  reportSchedules           ReportSchedule[]
  reportShares              ReportShare[]
  localListings             LocalListing[]
  listingCitations          ListingCitation[]
  listingReviews            ListingReview[]
  listingPhotos             ListingPhoto[]
  visibilitySnapshots       LocalVisibilitySnapshot[]
  leadSources               LeadSource[]
  leadCampaigns             LeadCampaign[]
  leads                     Lead[]
  leadPipelineStages        LeadPipelineStage[]
  leadActivities            LeadActivity[]

  @@index([status])
  @@index([createdAt])
  @@map("clients")
}

/// Billing/subscription state for a TAKATAK client workspace (Social).
/// Premium access must be derived from this record — never from frontend helpers.
/// planCode uses Social catalog codes (social_free, social_starter_5, …).
/// Domains/hosting billing stays on Upmind, not this row.
model ClientSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  clientId               String             @unique @db.Uuid
  status                 SubscriptionStatus @default(trial)
  planCode               String?
  planName               String?
  provider               String?
  externalCustomerId     String?
  externalSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// Paid X/Twitter connection slots. 0 until Stripe add-on checkout exists.
  xAccountAllowance      Int                @default(0)
  /// Studio/campaign analytics add-on. False until purchased.
  advancedAnalytics      Boolean            @default(false)
  /// Dev-only bypass. Must remain false in production.
  developmentBypass      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
  @@map("client_subscriptions")
}

/// Idempotency for Social Stripe webhooks. Payload is not stored.
model StripeWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique
  type          String
  clientId      String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@map("stripe_webhook_events")
}

/// Connects profiles/users to clients (future multi-client permissions).
model ClientMembership {
  id                String           @id @default(uuid()) @db.Uuid
  profileId         String           @db.Uuid
  clientId          String           @db.Uuid
  role              WorkspaceRole    @default(viewer)
  status            MembershipStatus @default(active)
  customPermissions PermissionKey[]  @default([])
  deniedPermissions PermissionKey[]  @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([profileId, clientId])
  @@index([clientId, status])
  @@index([profileId, status])
  @@map("client_memberships")
}

model UserInvitation {
  id                 String           @id @default(uuid()) @db.Uuid
  clientId           String           @db.Uuid
  email              String
  role               WorkspaceRole    @default(viewer)
  status             InvitationStatus @default(pending)
  tokenHash          String           @unique
  customPermissions  PermissionKey[]  @default([])
  deniedPermissions  PermissionKey[]  @default([])
  invitedByProfileId String?          @db.Uuid
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy Profile? @relation("InvitedByProfile", fields: [invitedByProfileId], references: [id], onDelete: SetNull)

  @@unique([clientId, email])
  @@index([clientId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("user_invitations")
}

/// Business or brand owned by a client.
model BusinessBrand {
  id           String      @id @default(uuid()) @db.Uuid
  clientId     String      @db.Uuid
  name         String
  legalName    String?
  category     String?
  website      String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String      @default("Canada")
  timezone     String      @default("America/Toronto")
  /// Explicitly uploaded brand/workspace image. Never overwritten by social connect.
  imageUrl     String?
  /// Connected social account chosen as this brand's avatar in Brand settings.
  imageSocialAccountId String? @db.Uuid
  /// Engagement rate display multiplier: 100 (per 100 reached) or 1000 (per 1000 reached).
  engagementRatio Int @default(100)
  /// Set by migration/runtime when Meta connection/Page identity was ambiguous.
  /// UI must force reconnect + Page reselection; never guess a canonical Page.
  requiresMetaPageReselection Boolean @default(false)
  status       BrandStatus @default(draft)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client                    Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  imageSocialAccount        SocialAccount?             @relation("BrandSelectedDisplayImage", fields: [imageSocialAccountId], references: [id], onDelete: SetNull)
  serviceInstances          ServiceInstance[]
  integrationAccounts       IntegrationAccount[]
  jobs                      Job[]
  reports                   Report[]
  socialAccounts            SocialAccount[]
  campaigns                 Campaign[]
  socialPosts               SocialPost[]
  socialContentItems        SocialContentItem[]
  socialCompetitorTracks    SocialCompetitorTrack[]
  socialCompetitorSnapshots SocialCompetitorSnapshot[]
  approvals                 Approval[]
  socialAnalyticsDaily      SocialAnalyticsDaily[]
  socialAccountSyncStates   SocialAccountSyncState[]
  socialAdAccounts          SocialAdAccount[]
  socialAdAnalyticsDaily    SocialAdAnalyticsDaily[]
  domainAssets              DomainAsset[]
  hostingServices           HostingService[]
  provisioningSteps         ProvisioningStep[]
  brandVoices               BrandVoice[]
  aiContentJobs             AiContentJob[]
  savedAiOutputs            SavedAiOutput[]
  reportSchedules           ReportSchedule[]
  localListings             LocalListing[]
  listingCitations          ListingCitation[]
  listingReviews            ListingReview[]
  listingPhotos             ListingPhoto[]
  visibilitySnapshots       LocalVisibilitySnapshot[]
  leadSources               LeadSource[]
  leadCampaigns             LeadCampaign[]
  leads                     Lead[]
  leadPipelineStages        LeadPipelineStage[]
  leadActivities            LeadActivity[]
  businessLocations         BusinessLocation[]
  socialProviderConnections SocialProviderConnection[]
  socialOAuthStates         SocialOAuthState[]
  socialBrandAssignments    SocialBrandAccountAssignment[]

  @@unique([id, clientId])
  @@index([clientId])
  @@index([status])
  @@index([imageSocialAccountId])
  @@map("business_brands")
}

/// Physical business location owned by one workspace and one brand.
/// This becomes the location boundary for Google Business, listings,
/// location-specific social accounts, and future local reporting.
model BusinessLocation {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  businessBrandId String         @db.Uuid
  name            String
  phone           String?
  website         String?
  addressLine1    String
  addressLine2    String?
  city            String
  region          String?
  postalCode      String?
  country         String         @default("Canada")
  timezone        String         @default("America/Toronto")
  latitude        Float?
  longitude       Float?
  isPrimary       Boolean        @default(false)
  status          LocationStatus @default(active)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  businessBrand  BusinessBrand   @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  socialAccounts SocialAccount[]

  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([city])
  @@index([isPrimary])
  @@map("business_locations")
}

/// Any service TAKATAK sells/manages. Provider here never implies connection.
model ServiceInstance {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  businessBrandId String?       @db.Uuid
  serviceType     ServiceType
  provider        Provider?
  name            String
  status          ServiceStatus @default(planned)
  priceCents      Int?
  currency        String        @default("CAD")
  renewalDate     DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand     BusinessBrand?     @relation(fields: [businessBrandId], references: [id])
  jobs              Job[]
  campaigns         Campaign[]
  domainAssets      DomainAsset[]
  hostingServices   HostingService[]
  provisioningSteps ProvisioningStep[]
  localListings     LocalListing[]
  leadCampaigns     LeadCampaign[]

  @@unique([clientId, businessBrandId, serviceType])
  @@index([clientId])
  @@index([businessBrandId])
  @@index([serviceType])
  @@index([status])
  @@index([provider])
  @@map("service_instances")
}

/// Provider account/configuration status per client/business.
/// Provider secrets are never stored in this table.
model IntegrationAccount {
  id                String            @id @default(uuid()) @db.Uuid
  clientId          String            @db.Uuid
  businessBrandId   String?           @db.Uuid
  provider          Provider
  externalAccountId String?
  displayName       String?
  status            IntegrationStatus @default(not_connected)
  lastSyncAt        DateTime?
  lastError         String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand  BusinessBrand?     @relation(fields: [businessBrandId], references: [id])
  events         IntegrationEvent[]
  socialAccounts SocialAccount[]

  @@unique([clientId, businessBrandId, provider])
  @@index([clientId])
  @@index([businessBrandId])
  @@index([provider])
  @@index([status])
  @@map("integration_accounts")
}

/// Future webhooks/events from providers.
model IntegrationEvent {
  id                   String                 @id @default(uuid()) @db.Uuid
  integrationAccountId String?                @db.Uuid
  provider             Provider
  eventType            String
  status               IntegrationEventStatus @default(received)
  payload              Json?
  errorMessage         String?
  createdAt            DateTime               @default(now())
  processedAt          DateTime?

  integrationAccount IntegrationAccount? @relation(fields: [integrationAccountId], references: [id])

  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("integration_events")
}

/// Tracks any automation/workflow job.
model Job {
  id                String    @id @default(uuid()) @db.Uuid
  clientId          String?   @db.Uuid
  businessBrandId   String?   @db.Uuid
  serviceInstanceId String?   @db.Uuid
  type              JobType
  status            JobStatus @default(planned)
  provider          Provider?
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  scheduledFor      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  /// Opaque worker lease token — only the lease owner may finalize/extend.
  leaseOwner        String?   @db.Uuid
  /// When the running lease expires, another worker may reclaim.
  leaseExpiresAt    DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client          Client?          @relation(fields: [clientId], references: [id])
  businessBrand   BusinessBrand?   @relation(fields: [businessBrandId], references: [id])
  serviceInstance ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])
  logs            JobLog[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([type])
  @@index([provider])
  @@index([createdAt])
  @@index([leaseOwner])
  @@index([type, status, scheduledFor, leaseExpiresAt])
  @@map("jobs")
}

/// Job history entries.
model JobLog {
  id        String      @id @default(uuid()) @db.Uuid
  jobId     String      @db.Uuid
  level     JobLogLevel @default(info)
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("job_logs")
}

/// Client/business report record.
model Report {
  id              String       @id @default(uuid()) @db.Uuid
  clientId        String       @db.Uuid
  businessBrandId String?      @db.Uuid
  type            ReportType
  title           String
  status          ReportStatus @default(draft)
  periodStart     DateTime?
  periodEnd       DateTime?
  summary         String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand?  @relation(fields: [businessBrandId], references: [id])
  sections      ReportSection[]
  metrics       ReportMetric[]
  shares        ReportShare[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("reports")
}

/// User/client notification center.
model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String?            @db.Uuid
  profileId         String?            @db.Uuid
  type              NotificationType   @default(system)
  title             String
  message           String
  status            NotificationStatus @default(unread)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime           @default(now())
  readAt            DateTime?

  client  Client?  @relation(fields: [clientId], references: [id])
  profile Profile? @relation(fields: [profileId], references: [id])

  @@index([clientId])
  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

/// Security and admin action history.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String?  @db.Uuid
  clientId   String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  profile Profile? @relation(fields: [profileId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([profileId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════
// Phase 5 — Social Media Module Foundation
// Metricool is NOT connected; these models are internal structure.
// ════════════════════════════════════════════════════════════

enum SocialPlatform {
  facebook
  instagram
  threads
  tiktok
  google_business
  linkedin
  x
  youtube
  pinterest
  bluesky
  twitch
}

enum SocialAccountStatus {
  not_connected
  pending_connection
  connected
  expired
  error
  disabled
}

/// Page/account eligibility relative to the current provider authorization.
enum SocialAccountAccessStatus {
  available
  selected
  permission_lost
  removed
  reauthorization_required
}

enum SocialConnectionProvider {
  meta
  instagram
  threads
  google
  linkedin
  tiktok
  pinterest
  x
  bluesky
  twitch
}

enum SocialConnectionStatus {
  not_connected
  pending_authorization
  authorized
  connected
  /// Credential expired/revoked/invalid or missing required permissions.
  reauthorization_required
  disconnected
  /// Setup failed and cannot currently continue.
  failed
  /// Legacy/general error bucket retained for existing rows and jobs.
  expired
  error
  disabled
}

/// Brand ↔ discovered social account (Facebook Page) assignment.
enum SocialBrandAssignmentStatus {
  active
  inactive
  permission_lost
}

/// Lifecycle of the encrypted credential row for one provider connection.
enum SocialCredentialStatus {
  active
  expired
  revoked
  invalid
  superseded
}

/// Data synchronization state for a selected social account.
/// Kept separate from SocialConnectionStatus (authorized vs connected).
enum SocialSyncStatus {
  /// Selected Page exists but initial sync has not started.
  idle
  /// Initial or resume sync is running.
  syncing
  /// Usable metrics synchronized for the requested range.
  ready
  /// Sync succeeded but Meta returned no data for the range.
  empty
  /// Partial data synchronized (pagination/partial provider failure).
  degraded
  /// Credential, permission, or Page access requires user action.
  action_required
  /// Retryable or non-auth synchronization failure.
  failed
}

enum SocialOAuthStateStatus {
  pending
  /// Claimed by a callback worker; not reusable and not yet completed.
  processing
  completed
  failed
  expired
  cancelled
}

enum CampaignStatus {
  draft
  planned
  active
  paused
  completed
  archived
}

enum PostStatus {
  draft
  pending_approval
  approved
  scheduled
  published
  failed
  /// Scheduled (or queued) but the current plan cannot publish it yet.
  blocked_by_plan
}

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested
  cancelled
}

enum AnalyticsSource {
  manual
  metricool
  provider_api
  internal_mock
}

/// Social platform account imported from an integration provider.
/// Tokens and provider credentials are never stored here.
/// Facebook Pages discovered via Meta are represented as platform=facebook
/// with accountType="facebook_page".
model SocialAccount {
  id                   String                    @id @default(uuid()) @db.Uuid
  clientId             String                    @db.Uuid
  businessBrandId      String?                   @db.Uuid
  integrationAccountId String?                   @db.Uuid
  providerConnectionId String?                   @db.Uuid
  businessLocationId   String?                   @db.Uuid
  externalAccountId    String?
  platform             SocialPlatform
  handle               String?
  displayName          String?
  profileUrl           String?
  profileImageUrl      String?
  category             String?
  accountType          String?
  status               SocialAccountStatus       @default(not_connected)
  accessStatus         SocialAccountAccessStatus @default(available)
  isAvailableThroughAuth Boolean                 @default(true)
  firstDiscoveredAt    DateTime?
  lastDiscoveredAt     DateTime?
  lastSyncAt           DateTime?
  metadata             Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand?            @relation(fields: [businessBrandId], references: [id])
  brandDisplaySelections BusinessBrand[]       @relation("BrandSelectedDisplayImage")
  integrationAccount IntegrationAccount?       @relation(fields: [integrationAccountId], references: [id])
  providerConnection SocialProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  businessLocation   BusinessLocation?         @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  posts              SocialPost[]
  contentItems       SocialContentItem[]
  analytics          SocialAnalyticsDaily[]
  brandAssignments   SocialBrandAccountAssignment[]
  syncState          SocialAccountSyncState?

  @@unique([integrationAccountId, platform, externalAccountId])
  @@unique([providerConnectionId, platform, externalAccountId])
  /// Partial unique: one connected Facebook Page per Client
  /// (see migration sa_one_connected_facebook_page_per_client_key).
  /// Partial unique: one connected Facebook Page per provider connection
  /// (see migration sa_one_connected_facebook_per_connection_key).
  /// Partial unique: one connected Instagram professional account per Client
  /// (see migration sa_one_connected_instagram_account_per_client_key).
  /// Partial unique: one connected Instagram professional account per connection
  /// (see migration sa_one_connected_instagram_per_connection_key).
  /// Partial unique: one connected YouTube channel per Client
  /// (see migration sa_one_connected_youtube_channel_per_client_key).
  /// Partial unique: one connected YouTube channel per Google connection
  /// (see migration sa_one_connected_youtube_per_connection_key).
  /// Partial unique: one connected TikTok account per Client
  /// (see migration sa_one_connected_tiktok_account_per_client_key).
  /// Partial unique: one connected TikTok account per connection
  /// (see migration sa_one_connected_tiktok_per_connection_key).
  /// Partial unique: one connected X account per Client
  /// (see migration sa_one_connected_x_account_per_client_key).
  /// Partial unique: one connected X account per connection
  /// (see migration sa_one_connected_x_per_connection_key).
  @@index([clientId])
  @@index([businessBrandId])
  @@index([integrationAccountId])
  @@index([providerConnectionId])
  @@index([businessLocationId])
  @@index([platform])
  @@index([status])
  @@index([accessStatus])
  @@index([clientId, platform, externalAccountId])
  @@index([isAvailableThroughAuth])
  @@map("social_accounts")
}

/// Sync lifecycle for one selected social account (Facebook Page).
/// Connection status stays on SocialProviderConnection; this row tracks data sync only.
model SocialAccountSyncState {
  id                   String           @id @default(uuid()) @db.Uuid
  clientId             String           @db.Uuid
  businessBrandId      String           @db.Uuid
  socialAccountId      String           @unique @db.Uuid
  providerConnectionId String           @db.Uuid
  status               SocialSyncStatus @default(idle)
  lastAttemptAt        DateTime?
  lastSuccessAt        DateTime?
  /// Sanitized category only — never raw Meta payloads.
  lastErrorCategory    String?
  lastErrorMessage     String?
  retryCount           Int              @default(0)
  /// Monotonic job ownership key — stale jobs must not overwrite a newer claim.
  syncGeneration       Int              @default(0)
  /// Durable Job.id for the in-flight sync_analytics worker (nullable).
  dispatchJobId        String?          @db.Uuid
  /// Opaque pagination/resume cursor (never a token).
  syncCursor           String?
  rangeStart           DateTime?        @db.Date
  rangeEnd             DateTime?        @db.Date
  timezone             String           @default("UTC")
  partialData          Boolean          @default(false)
  /// Provider-reported data freshness when known.
  providerSyncedAt     DateTime?
  /// Last YYYY-MM-DD that was successfully confirmed from Meta (watermark).
  lastConfirmedDate    DateTime?        @db.Date
  /// Days re-fetched on incremental runs for delayed Meta corrections.
  overlapDays          Int              @default(2)
  /// idle | running | complete | partial | unavailable
  backfillStatus       String           @default("idle")
  /// Next older day still needing historical backfill.
  backfillCursorDate   DateTime?        @db.Date
  /// Earliest day this Page will attempt to backfill.
  backfillHorizonStart DateTime?        @db.Date
  /// When the durable scheduler may enqueue the next incremental job.
  nextIncrementalAt    DateTime?
  /// initial | incremental | backfill
  lastSyncMode         String?
  /// unknown | complete | partial | unavailable | backfilling
  dataCompleteness     String           @default("unknown")
  graphApiVersion      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand            @relation(fields: [businessBrandId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount            @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  providerConnection SocialProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([providerConnectionId, status])
  @@index([lastAttemptAt])
  @@index([dispatchJobId])
  @@index([nextIncrementalAt])
  @@index([backfillStatus])
  @@index([clientId, status, nextIncrementalAt])
  @@map("social_account_sync_states")
}

/// One native OAuth/provider authorization owned by a TAKATAK
/// workspace and brand. This replaces the Metricool dependency.
///
/// A connection is not marked connected merely because credentials
/// exist. The provider adapter must authorize successfully and at
/// least one real external account must be assigned to the Brand.
model SocialProviderConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  clientId              String                   @db.Uuid
  businessBrandId       String                   @db.Uuid
  provider              SocialConnectionProvider
  status                SocialConnectionStatus   @default(not_connected)
  externalSubjectId     String?
  displayName           String?
  scopes                String[]                 @default([])
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  authorizedAt          DateTime?
  lastValidatedAt       DateTime?
  lastSyncAt            DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  lastErrorAt           DateTime?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  createdByProfileId    String?                  @db.Uuid
  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  createdBy     Profile?      @relation("SocialConnectionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  credential     SocialCredential?
  oauthStates    SocialOAuthState[]
  socialAccounts SocialAccount[]
  adAccounts     SocialAdAccount[]
  syncStates     SocialAccountSyncState[]

  /// Partial unique: at most one live shell
  /// (pending_authorization|authorized|connected) per Brand+provider
  /// — see migration spc_one_live_per_brand_provider_key.
  /// Partial unique: at most one pending_authorization per Brand+provider
  /// (spc_one_pending_per_brand_provider_key; subset of live unique).
  @@index([clientId, businessBrandId, provider])
  /// Same Meta user MAY authorize multiple Brands in one Client.
  /// Duplicate control is Brand-scoped live unique (above), not Client+subject unique.
  @@unique([id, clientId], map: "spc_id_client_key")
  @@unique([id, clientId, businessBrandId, provider], map: "spc_oauth_scope_key")
  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([provider, status])
  @@index([clientId, provider, externalSubjectId])
  @@index([externalSubjectId])
  @@index([createdByProfileId])
  @@index([accessTokenExpiresAt])
  @@index([authorizedAt])
  @@index([lastErrorAt])
  @@map("social_provider_connections")
}

/// Encrypted provider tokens.
///
/// The encryptedPayload column contains an AES-256-GCM encrypted JSON
/// payload. Plain access tokens and refresh tokens are never stored.
/// tokenType (when present) lives inside encryptedPayload, not plaintext.
model SocialCredential {
  id               String                 @id @default(uuid()) @db.Uuid
  clientId         String                 @db.Uuid
  connectionId     String                 @unique @db.Uuid
  status           SocialCredentialStatus @default(active)
  encryptedPayload String
  iv               String
  authTag          String
  keyVersion       Int                    @default(1)
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  lastValidatedAt  DateTime?
  statusChangedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  connection SocialProviderConnection @relation(fields: [connectionId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([connectionId, clientId], map: "social_credentials_connection_client_key")
  @@index([clientId])
  @@index([status])
  @@index([tokenExpiresAt])
  @@index([refreshExpiresAt])
  @@index([lastValidatedAt])
  @@map("social_credentials")
}

/// Assigns a discovered social account (e.g. Facebook Page) to a Brand.
/// Provider authorization stays on SocialProviderConnection; this row is
/// the Brand selection record. Tokens are never stored here.
model SocialBrandAccountAssignment {
  id                 String                      @id @default(uuid()) @db.Uuid
  clientId           String                      @db.Uuid
  businessBrandId    String                      @db.Uuid
  socialAccountId    String                      @db.Uuid
  status             SocialBrandAssignmentStatus @default(active)
  assignedAt         DateTime                    @default(now())
  assignedByProfileId String?                    @db.Uuid
  unassignedAt       DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  assignedBy    Profile?      @relation("SocialBrandAssignmentAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  /// One Brand ↔ Page pair row (status flips preserve history fields).
  @@unique([businessBrandId, socialAccountId])
  /// Partial unique: one active assignment per socialAccountId
  /// (sbaa_one_active_account_key).
  /// Partial unique: one active assignment per brand
  /// (sbaa_one_active_per_brand_key) — selected Facebook Page is canonical.
  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([socialAccountId, status])
  @@index([assignedByProfileId])
  @@map("social_brand_account_assignments")
}

/// One short-lived OAuth authorization attempt.
///
/// Only a SHA-256 hash of the public state value is stored. The PKCE
/// verifier is encrypted with the social token encryption key.
model SocialOAuthState {
  id                     String                   @id @default(uuid()) @db.Uuid
  clientId               String                   @db.Uuid
  businessBrandId        String                   @db.Uuid
  connectionId           String?                  @db.Uuid
  provider               SocialConnectionProvider
  status                 SocialOAuthStateStatus   @default(pending)
  stateHash              String                   @unique
  codeVerifierCiphertext String
  codeVerifierIv         String
  codeVerifierAuthTag    String
  returnPath             String                   @default("/dashboard/social/accounts")
  expiresAt              DateTime
  consumedAt             DateTime?
  createdByProfileId     String?                  @db.Uuid
  errorMessage           String?
  metadata               Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand             @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  connection    SocialProviderConnection? @relation(fields: [connectionId, clientId, businessBrandId, provider], references: [id, clientId, businessBrandId, provider], onDelete: Cascade)
  createdBy     Profile?                  @relation("SocialOAuthCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([connectionId])
  @@index([provider, status])
  @@index([expiresAt])
  @@index([createdByProfileId])
  @@map("social_oauth_states")
}

/// Social media campaign owned by a client/brand.
model Campaign {
  id                String         @id @default(uuid()) @db.Uuid
  clientId          String         @db.Uuid
  businessBrandId   String?        @db.Uuid
  serviceInstanceId String?        @db.Uuid
  name              String
  goal              String?
  description       String?
  status            CampaignStatus @default(draft)
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand?         @relation(fields: [businessBrandId], references: [id])
  serviceInstance ServiceInstance?       @relation(fields: [serviceInstanceId], references: [id])
  posts           SocialPost[]
  analytics       SocialAnalyticsDaily[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
  @@map("campaigns")
}

/// Internal TAKATAK post draft/approval/scheduling record.
/// Status machine: draft → pending_approval → approved → scheduled →
/// published/failed. Publishing is NOT implemented until Metricool (Phase 6).
model SocialPost {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  businessBrandId String?        @db.Uuid
  campaignId      String?        @db.Uuid
  socialAccountId String?        @db.Uuid
  platform        SocialPlatform
  caption         String
  status          PostStatus     @default(draft)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  mediaUrls       Json?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  approvals     Approval[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([campaignId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("social_posts")
}

/// Synced Facebook Page content (posts, reels, stories) from Meta.
/// Provider object IDs stay server-side only — never returned to UI/logs.
model SocialContentItem {
  id                   String               @id @default(uuid()) @db.Uuid
  clientId             String               @db.Uuid
  businessBrandId      String               @db.Uuid
  socialAccountId      String               @db.Uuid
  /// post | reel | story
  contentType          String
  /// Opaque stable hash of provider object id (not reversible in UI).
  externalIdHash       String
  /// Encrypted/provider-only; never select in client APIs.
  externalObjectId     String
  publishedAt          DateTime
  captionExcerpt       String?
  permalinkUrl         String?
  thumbnailUrl         String?
  /// available | deleted | expired | unknown
  availability         String               @default("available")
  /// Confirmed metrics — null means unavailable (—), 0 means confirmed zero.
  reach                Int?
  views                Int?
  reactions            Int?
  comments             Int?
  shares               Int?
  engagement           Int?
  /// Per-metric provenance/status JSON (confirmed|unavailable|partial|permission_denied|privacy_threshold).
  metricStatus         Json?
  graphApiVersion      String?
  retrievedAt          DateTime?
  firstSeenAt          DateTime             @default(now())
  lastSeenAt           DateTime             @default(now())
  deletedAt            DateTime?
  expiredAt            DateTime?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand  @relation(fields: [businessBrandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, contentType, externalIdHash], map: "sci_account_type_hash_key")
  @@index([clientId, businessBrandId, contentType, publishedAt])
  @@index([socialAccountId, publishedAt])
  @@index([socialAccountId, availability])
  @@index([clientId, publishedAt])
  @@map("social_content_items")
}

/// Brand-scoped Facebook competitor Page track (public Meta data only).
/// Never stores private insights. Provider Page IDs stay server-only.
model SocialCompetitorTrack {
  id                 String    @id @default(uuid()) @db.Uuid
  clientId           String    @db.Uuid
  businessBrandId    String    @db.Uuid
  /// Client-facing opaque ref — never the provider Page ID.
  publicRef          String
  /// Opaque hash of provider Page id (not reversible in UI).
  externalPageIdHash String
  /// Provider Page id — server-only; never select in client APIs.
  externalPageId     String
  usernameCanonical  String?
  /// Local rename; does not alter Meta identity.
  displayLabel       String?
  pageName           String?
  profileImageUrl    String?
  category           String?
  /// active | removed
  status             String    @default("active")
  /// available | stale | unavailable | permission_denied | rate_limited | failed | pending
  availability       String    @default("pending")
  /// ready | feature_required | permission_denied | unavailable | unknown
  capabilityStatus   String    @default("unknown")
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastErrorCategory  String?
  lastErrorMessage   String?
  nextRefreshAt      DateTime?
  dispatchJobId      String?   @db.Uuid
  syncGeneration     Int       @default(0)
  graphApiVersion    String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client        Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand              @relation(fields: [businessBrandId], references: [id], onDelete: Cascade)
  snapshots     SocialCompetitorSnapshot[]

  @@unique([clientId, businessBrandId, publicRef], map: "sct_brand_public_ref_key")
  @@unique([clientId, businessBrandId, externalPageIdHash], map: "sct_brand_page_hash_key")
  @@index([clientId, businessBrandId, status])
  @@index([nextRefreshAt])
  @@index([dispatchJobId])
  @@map("social_competitor_tracks")
}

/// Dated public snapshot for one competitor track (separate from private Page analytics).
model SocialCompetitorSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  clientId             String   @db.Uuid
  businessBrandId      String   @db.Uuid
  competitorTrackId    String   @db.Uuid
  snapshotAt           DateTime
  /// Calendar day of the snapshot (UTC) for idempotent upserts.
  snapshotDate         DateTime @db.Date
  followerCount        Int?
  /// followers_count | fan_count | null when unavailable
  followerFieldSource  String?
  pageName             String?
  category             String?
  profileImageUrl      String?
  /// Public feed post count in probe window when PPCA permits; else null.
  publicPostCount      Int?
  publicReactionsSum   Int?
  publicCommentsSum    Int?
  publicSharesSum      Int?
  /// confirmed | partial | stale | unavailable | permission_denied | rate_limited | failed
  availability         String   @default("unavailable")
  metricStatus         Json?
  graphApiVersion      String?
  retrievedAt          DateTime
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client           Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand    BusinessBrand         @relation(fields: [businessBrandId], references: [id], onDelete: Cascade)
  competitorTrack  SocialCompetitorTrack @relation(fields: [competitorTrackId], references: [id], onDelete: Cascade)

  @@unique([competitorTrackId, snapshotDate], map: "scs_track_date_key")
  @@index([clientId, businessBrandId, snapshotDate])
  @@index([competitorTrackId, snapshotAt])
  @@map("social_competitor_snapshots")
}

/// Client approval workflow for social posts.
model Approval {
  id                   String         @id @default(uuid()) @db.Uuid
  clientId             String         @db.Uuid
  businessBrandId      String?        @db.Uuid
  socialPostId         String         @db.Uuid
  requestedByProfileId String?        @db.Uuid
  reviewedByProfileId  String?        @db.Uuid
  status               ApprovalStatus @default(pending)
  comments             String?
  requestedAt          DateTime       @default(now())
  reviewedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  socialPost    SocialPost     @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  requestedBy   Profile?       @relation("RequestedApprovals", fields: [requestedByProfileId], references: [id])
  reviewedBy    Profile?       @relation("ReviewedApprovals", fields: [reviewedByProfileId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([socialPostId])
  @@index([status])
  @@index([requestedAt])
  @@map("approvals")
}

/// Future daily analytics (Metricool/provider sync in Phase 6+).
/// Nothing here is ever seeded as metricool data before real sync exists.
model SocialAnalyticsDaily {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  businessBrandId String?         @db.Uuid
  socialAccountId String?         @db.Uuid
  campaignId      String?         @db.Uuid
  platform        SocialPlatform
  date            DateTime        @db.Date
  reach           Int             @default(0)
  impressions     Int             @default(0)
  engagement      Int             @default(0)
  clicks          Int             @default(0)
  followers       Int             @default(0)
  source          AnalyticsSource @default(manual)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])

  /// Idempotent provider sync upserts — one daily row per account+date+source.
  @@unique([socialAccountId, date, source], map: "sad_account_date_source_key")
  @@index([clientId])
  @@index([businessBrandId])
  @@index([platform])
  @@index([date])
  @@index([source])
  @@map("social_analytics_daily")
}

// ============================================================
// TAKATAK SOCIAL ADVERTISING ANALYTICS
// ============================================================

enum SocialAdPlatform {
  meta_ads
  google_ads
}

enum SocialAdAccountStatus {
  not_connected
  pending_connection
  connected
  expired
  error
  disabled
}

/// A real advertising account imported through a native provider
/// authorization. Provider credentials are never stored here.
model SocialAdAccount {
  id                   String                @id @default(uuid()) @db.Uuid
  clientId             String                @db.Uuid
  businessBrandId      String                @db.Uuid
  providerConnectionId String?               @db.Uuid
  platform             SocialAdPlatform
  externalAccountId    String
  displayName          String?
  currency             String                @default("CAD")
  timezone             String                @default("America/Toronto")
  status               SocialAdAccountStatus @default(not_connected)
  lastSyncAt           DateTime?
  metadata             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand             @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  providerConnection SocialProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  analytics          SocialAdAnalyticsDaily[]

  @@unique([clientId, businessBrandId, platform, externalAccountId], map: "social_ad_accounts_provider_key")
  @@unique([id, clientId, businessBrandId], map: "social_ad_accounts_scope_key")
  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([providerConnectionId])
  @@index([platform, status])
  @@index([lastSyncAt])
  @@map("social_ad_accounts")
}

/// Daily verified advertising analytics.
///
/// CPM and CPC are calculated from impressions, clicks, and spend.
model SocialAdAnalyticsDaily {
  id              String           @id @default(uuid()) @db.Uuid
  clientId        String           @db.Uuid
  businessBrandId String           @db.Uuid
  adAccountId     String           @db.Uuid
  platform        SocialAdPlatform
  date            DateTime         @db.Date
  impressions     Int              @default(0)
  clicks          Int              @default(0)
  spendMinor      Int              @default(0)
  currency        String           @default("CAD")
  source          AnalyticsSource  @default(manual)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand   @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  adAccount     SocialAdAccount @relation(fields: [adAccountId, clientId, businessBrandId], references: [id, clientId, businessBrandId], onDelete: Cascade)

