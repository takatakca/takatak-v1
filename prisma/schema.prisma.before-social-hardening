  localListing  LocalListing?  @relation(fields: [localListingId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([localListingId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("listing_photos")
}

/// Local visibility snapshot. Seeded rows use internal_foundation only —
/// never a real local SEO score from any provider.
model LocalVisibilitySnapshot {
  id              String           @id @default(uuid()) @db.Uuid
  clientId        String           @db.Uuid
  businessBrandId String?          @db.Uuid
  localListingId  String?          @db.Uuid
  source          VisibilitySource @default(internal_foundation)
  score           Int?
  listingsCount   Int              @default(0)
  citationsCount  Int              @default(0)
  reviewsCount    Int              @default(0)
  averageRating   Float?
  notes           String?
  capturedAt      DateTime
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  localListing  LocalListing?  @relation(fields: [localListingId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([localListingId])
  @@index([source])
  @@index([capturedAt])
  @@index([createdAt])
  @@map("local_visibility_snapshots")
}

// ════════════════════════════════════════════════════════════
// Phase 12 — Leads / FLEXS Module Foundation
// FLEXS is NOT connected. Every "_internal" status is internal
// foundation tracking only — no lead was really imported,
// contacted, converted, or won via any provider or automation.
// ════════════════════════════════════════════════════════════

enum LeadSourceType {
  website_form
  social_media
  local_listing
  referral
  phone_call
  email
  paid_ads
  flexs
  manual
  internal_demo
  future_provider
}

enum LeadProvider {
  flexs
  qmaps
  metricool
  google_business
  manual
  internal_demo
  future_provider
}

enum LeadSourceStatus {
  planned
  active_internal
  paused
  disabled
  archived
}

enum LeadCampaignStatus {
  draft
  planned
  active_internal
  paused
  completed_internal
  archived
}

enum LeadStatus {
  new_internal
  follow_up_planned
  contacted_internal
  qualified_internal
  proposal_planned
  won_internal
  lost_internal
  archived
}

enum LeadPriority {
  low
  normal
  high
  urgent
}

enum PipelineStageStatus {
  active_internal
  paused
  archived
}

enum LeadActivityType {
  note
  follow_up
  call
  email
  meeting
  proposal
  status_change
  internal_reminder
}

enum LeadActivityStatus {
  planned
  completed_internal
  cancelled
  archived
}

/// Where leads come from. "active_internal" = internal foundation source
/// only, never real provider sync.
model LeadSource {
  id              String           @id @default(uuid()) @db.Uuid
  clientId        String           @db.Uuid
  businessBrandId String?          @db.Uuid
  name            String
  type            LeadSourceType   @default(manual)
  provider        LeadProvider     @default(internal_demo)
  status          LeadSourceStatus @default(planned)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  leads         Lead[]
  leadCampaigns LeadCampaign[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([type])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("lead_sources")
}

/// Lead generation campaign. No real ad spend or paid sync exists.
model LeadCampaign {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @db.Uuid
  businessBrandId   String?            @db.Uuid
  leadSourceId      String?            @db.Uuid
  serviceInstanceId String?            @db.Uuid
  name              String
  goal              String?
  status            LeadCampaignStatus @default(draft)
  startsAt          DateTime?
  endsAt            DateTime?
  budgetCents       Int?
  currency          String             @default("CAD")
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand?   @relation(fields: [businessBrandId], references: [id])
  leadSource      LeadSource?      @relation(fields: [leadSourceId], references: [id])
  serviceInstance ServiceInstance? @relation(fields: [serviceInstanceId], references: [id])
  leads           Lead[]
  activities      LeadActivity[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadSourceId])
  @@index([serviceInstanceId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
  @@map("lead_campaigns")
}

/// A lead/contact opportunity. All "_internal" statuses are internal
/// foundation tracking — no external contact or real conversion happened.
model Lead {
  id                String       @id @default(uuid()) @db.Uuid
  clientId          String       @db.Uuid
  businessBrandId   String?      @db.Uuid
  leadSourceId      String?      @db.Uuid
  leadCampaignId    String?      @db.Uuid
  name              String?
  email             String?
  phone             String?
  company           String?
  message           String?
  status            LeadStatus   @default(new_internal)
  priority          LeadPriority @default(normal)
  valueCents        Int?
  currency          String       @default("CAD")
  assignedProfileId String?      @db.Uuid
  followUpAt        DateTime?
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  leadSource      LeadSource?    @relation(fields: [leadSourceId], references: [id])
  leadCampaign    LeadCampaign?  @relation(fields: [leadCampaignId], references: [id])
  assignedProfile Profile?       @relation("AssignedLeads", fields: [assignedProfileId], references: [id])
  activities      LeadActivity[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadSourceId])
  @@index([leadCampaignId])
  @@index([assignedProfileId])
  @@index([status])
  @@index([priority])
  @@index([followUpAt])
  @@index([createdAt])
  @@map("leads")
}

/// Pipeline stage configuration per client/brand. Foundation config only.
model LeadPipelineStage {
  id              String              @id @default(uuid()) @db.Uuid
  clientId        String              @db.Uuid
  businessBrandId String?             @db.Uuid
  name            String
  status          PipelineStageStatus @default(active_internal)
  order           Int                 @default(0)
  color           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([order])
  @@index([createdAt])
  @@map("lead_pipeline_stages")
}

/// Lead activity/follow-up history. "completed_internal" is internal
/// tracking only — no real call, email, or automation ran.
model LeadActivity {
  id              String             @id @default(uuid()) @db.Uuid
  clientId        String             @db.Uuid
  businessBrandId String?            @db.Uuid
  leadId          String?            @db.Uuid
  leadCampaignId  String?            @db.Uuid
  type            LeadActivityType   @default(note)
  status          LeadActivityStatus @default(planned)
  title           String
  note            String?
  dueAt           DateTime?
  completedAt     DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id])
  leadCampaign  LeadCampaign?  @relation(fields: [leadCampaignId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([leadId])
  @@index([leadCampaignId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
  @@map("lead_activities")
}
