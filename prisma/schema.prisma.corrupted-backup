// ════════════════════════════════════════════════════════════
// Phase 5 — Social Media Module Foundation
// Metricool is NOT connected; these models are internal structure.
// ════════════════════════════════════════════════════════════

enum SocialPlatform {
  facebook
  instagram
  threads
  tiktok
  google_business
  linkedin
  x
  youtube
  pinterest
  bluesky
  twitch
}

enum SocialAccountStatus {
  not_connected
  pending_connection
  connected
  expired
  error
  disabled
}

enum SocialConnectionProvider {
  meta
  google
  linkedin
  tiktok
  pinterest
  x
  bluesky
  twitch
}

enum SocialConnectionStatus {
  not_connected
  pending_authorization
  authorized
  connected
  expired
  error
  disconnected
  disabled
}

enum SocialOAuthStateStatus {
  pending
  completed
  failed
  expired
  cancelled
}

enum CampaignStatus {
  draft
  planned
  active
  paused
  completed
  archived
}

enum PostStatus {
  draft
  pending_approval
  approved
  scheduled
  published
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested
  cancelled
}

enum AnalyticsSource {
  manual
  metricool
  provider_api
  internal_mock
}

/// Social platform account imported from an integration provider.
/// Tokens and provider credentials are never stored here.
model SocialAccount {
  id                   String              @id @default(uuid()) @db.Uuid
  clientId             String              @db.Uuid
  businessBrandId      String?             @db.Uuid
  integrationAccountId String?             @db.Uuid
  providerConnectionId String?             @db.Uuid
  businessLocationId   String?             @db.Uuid
  externalAccountId    String?
  platform             SocialPlatform
  handle               String?
  displayName          String?
  profileUrl           String?
  accountType          String?
  status               SocialAccountStatus @default(not_connected)
  lastSyncAt           DateTime?
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand      BusinessBrand?            @relation(fields: [businessBrandId], references: [id])
  integrationAccount IntegrationAccount?       @relation(fields: [integrationAccountId], references: [id])
  providerConnection SocialProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  businessLocation   BusinessLocation?         @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  posts              SocialPost[]
  analytics          SocialAnalyticsDaily[]

  @@unique([integrationAccountId, platform, externalAccountId])
  @@unique([providerConnectionId, platform, externalAccountId])
  @@index([clientId])
  @@index([businessBrandId])
  @@index([integrationAccountId])
  @@index([providerConnectionId])
  @@index([businessLocationId])
  @@index([platform])
  @@index([status])
  @@map("social_accounts")
}

/// One native OAuth/provider authorization owned by a TAKATAK
/// workspace and brand. This replaces the Metricool dependency.
///
/// A connection is not marked connected merely because credentials
/// exist. The provider adapter must authorize successfully and at
/// least one real external account must be imported.
model SocialProviderConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  clientId              String                   @db.Uuid
  businessBrandId       String                   @db.Uuid
  provider              SocialConnectionProvider
  status                SocialConnectionStatus   @default(not_connected)
  externalSubjectId     String?
  displayName           String?
  scopes                String[]                 @default([])
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  lastValidatedAt       DateTime?
  lastSyncAt            DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  createdByProfileId    String?                  @db.Uuid
  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  createdBy     Profile?      @relation("SocialConnectionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  credential     SocialCredential?
  oauthStates    SocialOAuthState[]
  socialAccounts SocialAccount[]

  @@unique([clientId, businessBrandId, provider])
  @@unique([id, clientId], map: "spc_id_client_key")
  @@unique([id, clientId, businessBrandId, provider], map: "spc_oauth_scope_key")
  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([provider, status])
  @@index([createdByProfileId])
  @@index([accessTokenExpiresAt])
  @@map("social_provider_connections")
}

/// Encrypted provider tokens.
///
/// The encryptedPayload column contains an AES-256-GCM encrypted JSON
/// payload. Plain access tokens and refresh tokens are never stored.
model SocialCredential {
  id               String    @id @default(uuid()) @db.Uuid
  clientId         String    @db.Uuid
  connectionId     String    @unique @db.Uuid
  encryptedPayload String
  iv               String
  authTag          String
  keyVersion       Int       @default(1)
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  connection SocialProviderConnection @relation(fields: [connectionId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([connectionId, clientId], map: "social_credentials_connection_client_key")
  @@index([clientId])
  @@index([tokenExpiresAt])
  @@index([refreshExpiresAt])
  @@map("social_credentials")
}

/// One short-lived OAuth authorization attempt.
///
/// Only a SHA-256 hash of the public state value is stored. The PKCE
/// verifier is encrypted with the social token encryption key.
model SocialOAuthState {
  id                     String                   @id @default(uuid()) @db.Uuid
  clientId               String                   @db.Uuid
  businessBrandId        String                   @db.Uuid
  connectionId           String?                  @db.Uuid
  provider               SocialConnectionProvider
  status                 SocialOAuthStateStatus   @default(pending)
  stateHash              String                   @unique
  codeVerifierCiphertext String
  codeVerifierIv         String
  codeVerifierAuthTag    String
  returnPath             String                   @default("/dashboard/social/accounts")
  expiresAt              DateTime
  consumedAt             DateTime?
  createdByProfileId     String?                  @db.Uuid
  errorMessage           String?
  metadata               Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand             @relation(fields: [businessBrandId, clientId], references: [id, clientId], onDelete: Cascade)
  connection    SocialProviderConnection? @relation(fields: [connectionId, clientId, businessBrandId, provider], references: [id, clientId, businessBrandId, provider], onDelete: Cascade)
  createdBy     Profile?                  @relation("SocialOAuthCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([businessBrandId, status])
  @@index([connectionId])
  @@index([provider, status])
  @@index([expiresAt])
  @@index([createdByProfileId])
  @@map("social_oauth_states")
}

/// Social media campaign owned by a client/brand.
model Campaign {
  id                String         @id @default(uuid()) @db.Uuid
  clientId          String         @db.Uuid
  businessBrandId   String?        @db.Uuid
  serviceInstanceId String?        @db.Uuid
  name              String
  goal              String?
  description       String?
  status            CampaignStatus @default(draft)
  startsAt          DateTime?
  endsAt            DateTime?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand   BusinessBrand?         @relation(fields: [businessBrandId], references: [id])
  serviceInstance ServiceInstance?       @relation(fields: [serviceInstanceId], references: [id])
  posts           SocialPost[]
  analytics       SocialAnalyticsDaily[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
  @@map("campaigns")
}

/// Internal TAKATAK post draft/approval/scheduling record.
/// Status machine: draft → pending_approval → approved → scheduled →
/// published/failed. Publishing is NOT implemented until Metricool (Phase 6).
model SocialPost {
  id              String         @id @default(uuid()) @db.Uuid
  clientId        String         @db.Uuid
  businessBrandId String?        @db.Uuid
  campaignId      String?        @db.Uuid
  socialAccountId String?        @db.Uuid
  platform        SocialPlatform
  caption         String
  status          PostStatus     @default(draft)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  mediaUrls       Json?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  approvals     Approval[]

  @@index([clientId])
  @@index([businessBrandId])
  @@index([campaignId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("social_posts")
}

/// Client approval workflow for social posts.
model Approval {
  id                   String         @id @default(uuid()) @db.Uuid
  clientId             String         @db.Uuid
  businessBrandId      String?        @db.Uuid
  socialPostId         String         @db.Uuid
  requestedByProfileId String?        @db.Uuid
  reviewedByProfileId  String?        @db.Uuid
  status               ApprovalStatus @default(pending)
  comments             String?
  requestedAt          DateTime       @default(now())
  reviewedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessBrand BusinessBrand? @relation(fields: [businessBrandId], references: [id])
  socialPost    SocialPost     @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  requestedBy   Profile?       @relation("RequestedApprovals", fields: [requestedByProfileId], references: [id])
  reviewedBy    Profile?       @relation("ReviewedApprovals", fields: [reviewedByProfileId], references: [id])

  @@index([clientId])
  @@index([businessBrandId])
  @@index([socialPostId])
  @@index([status])
  @@index([requestedAt])
  @@map("approvals")
}

/// Future daily analytics (Metricool/provider sync in Phase 6+).
/// Nothing here is ever seeded as metricool data before real sync exists.
model SocialAnalyticsDaily {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  businessBrandId String?         @db.Uuid
  socialAccountId String?         @db.Uuid
  campaignId      String?         @db.Uuid
  platform        SocialPlatform
  date            DateTime        @db.Date
  reach           Int             @default(0)
  impressions     Int             @default(0)
  engagement      Int             @default(0)
  clicks          Int             @default(0)
  followers       Int             @default(0)
  source          AnalyticsSource @default(manual)
  metadata        Json?
