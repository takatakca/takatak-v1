// ════════════════════════════════════════════════════════════
// Phase 7 — Web / Domain / Hosting Module Foundation
// Upmind is NOT connected; these models are internal structure.
// "active_internal" / "completed_internal" / "internal_demo" never
// imply real provider provisioning.
// ════════════════════════════════════════════════════════════

enum DomainStatus {
  planned
  pending_connection
  tracked
  expiring_soon
  expired
  cancelled
}

enum DnsStatus {
  unknown
  not_configured
  pending
  valid
  warning
  error
}

enum SslStatus {
  unknown
